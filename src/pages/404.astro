---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { languages, type Lang } from "../i18n/ui";
import { getLocalizedPath, useTranslations } from "../i18n/utils";

const requested = Astro.url.pathname.split("/")[1] as Lang;
const lang: Lang = requested in languages ? requested : "es";
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={t("notfound.title")}
  description={t("notfound.support")}
>
  <SiteHeader slot="header" lang={lang} />

  <section class="hero">
    <p class="brand-line mono caption-3">404</p>
    <h1 class="heading-1">{t("notfound.title")}</h1>
    <p class="support body-3">{t("notfound.support")}</p>
    <div class="ctas">
      <a class="cta-primary" href={getLocalizedPath(lang, "/")}>{t("notfound.cta")}</a>
    </div>
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  .hero {
    padding: var(--space-200) 0 var(--space-600);
  }
  .brand-line {
    margin: 0 0 var(--space-100);
    color: var(--muted-2);
  }
  .hero h1 {
    margin: 0 0 var(--space-200);
  }
  .support {
    max-width: 680px;
    margin: 0 0 var(--space-300);
    color: var(--muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-100);
  }
  @media (max-width: 720px) {
    .hero h1 {
      font-size: var(--text-4xl);
      line-height: 40px;
    }
  }
</style>
