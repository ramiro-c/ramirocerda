{
  "name": "ramirocerda-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-23",
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "botardo-kb"
    }
  ],
  // Usage analytics (writeUsage in src/index.ts). The key must be
  // "analytics_engine_datasets": the old "analytics_engine" key was not a valid
  // wrangler field, so the binding was never created and writeUsage no-oped.
  // The dataset name is pinned here and must match DATASET in
  // scripts/chat-stats.mjs (without "dataset" it would default to "ANALYTICS").
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "ramirocerda_chat_ANALYTICS"
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      // Any positive integer, unique per binding on the account. Nothing to create: deploy sets it up (works on Free).
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "TOP_K": "5",
    "SIMILARITY_THRESHOLD": "0.30",
    // Rerank: dense top-15 -> cross-encoder top-6. Fail-open.
    "RAG_RERANK_MODEL": "@cf/baai/bge-reranker-base",
    "RAG_RERANK_CANDIDATES": "15",
    "GENERATION_MODEL": "deepseek-v4.1-flash",
    "OPENCODE_GO_ENDPOINT": "https://opencode.ai/zen/go/v1/chat/completions",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "SITE_ORIGIN": "https://ramirocerda.com.ar",
    "ADAPTIVE_RAG": "1",
    "DECISION_ENDPOINT": "https://opencode.ai/inference/systemone/v1/systemone",
    // Paid primary (jev-1.13): ~3x faster than the anonymous free tier (jev-1.13-free).
    // Both tiers are paid here, so every call bills to the Console balance; the retry
    // reuses the same paid model. To fall back to the free tier for cost, set
    // DECISION_FALLBACK_MODEL back to "jev-1.13-free" (the code sends no key to free slugs).
    "DECISION_MODEL": "jev-1.13",
    "DECISION_FALLBACK_MODEL": "jev-1.13",
    "DECISION_INTEGRATION_ID": "opencode",
    "DECISION_TIMEOUT_MS": "1000",
    "DECISION_MIN_CONFIDENCE": "0.5",
    "JUDGE_SUFFICIENT_THRESHOLD": "0.4",
    "MAX_RETRIEVAL_ITERATIONS": "2"
  },
  "observability": {
    "enabled": true
  }
}
