{
  "name": "ramirocerda-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-23",
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "botardo-kb"
    }
  ],
  "analytics_engine": [
    {
      "binding": "ANALYTICS"
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      // Unique namespace on the Cloudflare account; must exist before deploy.
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "RAG_ENABLED": "true",
    "TOP_K": "5",
    "SIMILARITY_THRESHOLD": "0.30",
    "GENERATION_MODEL": "deepseek-v4.1-flash",
    "OPENCODE_GO_ENDPOINT": "https://opencode.ai/zen/go/v1/chat/completions",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "SITE_ORIGIN": "https://ramirocerda.com.ar"
  },
  "observability": {
    "enabled": true
  }
}
