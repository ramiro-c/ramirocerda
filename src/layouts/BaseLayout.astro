---
import "../styles/global.css";
import Botardo from "../components/Botardo.astro";
import BottomDock from "../components/BottomDock.astro";
import ContactDialog from "../components/ContactDialog.astro";
import { STORAGE_KEYS } from "../config/site";
import { isNotFoundPath, switchLangPath, useTranslations } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  lang: "es" | "en";
  /**
   * Section of a detail page (a note or a project). The document <title> then
   * reads "<title> · <localized section> · Ramiro Cerdá", so an ES/EN pair whose
   * content keeps the same title (a brand name, an English note title) still gets
   * two distinct titles. og:title stays the bare content title.
   */
  section?: "notes" | "work";
}

const { title, description, lang, section } = Astro.props;
const t = useTranslations(lang);
const documentTitle = section ? `${title} · ${t(`nav.${section}`)} · Ramiro Cerdá` : title;
const isNotFound = isNotFoundPath(Astro.url.pathname);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogLocale = lang === "es" ? "es_AR" : "en_US";
const ogLocaleAlternate = lang === "es" ? "en_US" : "es_AR";
const esURL = new URL(switchLangPath(Astro.url.pathname, "es"), Astro.site);
const enURL = new URL(switchLangPath(Astro.url.pathname, "en"), Astro.site);
const homeURL = new URL(lang === "es" ? "/" : "/en/", Astro.site);
const inLanguage = lang === "es" ? "es-AR" : "en-US";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${homeURL.href}#website`,
      name: "Ramiro Cerdá",
      url: homeURL.href,
      inLanguage,
      publisher: { "@id": `${homeURL.href}#person` },
    },
    {
      "@type": "Person",
      "@id": `${homeURL.href}#person`,
      name: "Ramiro Cerdá",
      url: homeURL.href,
      jobTitle: "Tech Lead",
      knowsAbout: [
        "AI agents",
        "Full stack development",
        "Retrieval-augmented generation",
        "LLM evaluation",
        "Performance optimization",
        "Observability",
      ],
      address: {
        "@type": "PostalAddress",
        addressLocality: "Buenos Aires",
        addressCountry: "AR",
      },
      sameAs: [
        "https://github.com/ramiro-c",
        "https://www.linkedin.com/in/cerdaramiro/",
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang} data-mermaid-expand={t("mermaid.expand")} data-mermaid-close={t("mermaid.close")}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/rc.png" />
    {
      isNotFound ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonicalURL} />
          <link rel="alternate" hreflang="es" href={esURL} />
          <link rel="alternate" hreflang="en" href={enURL} />
          <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ramiro Cerdá" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!isNotFound && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{documentTitle}</title>
    <script is:inline define:vars={{ keys: STORAGE_KEYS }}>
      // Anonymous visitor state, before first paint so returning visitors never
      // see the first visit copy flash. First party storage only: a random id
      // and a visit counter (one visit per browser session). See /privacy/.
      (function () {
        var root = document.documentElement;
        root.classList.add("js");
        try {
          var id = localStorage.getItem(keys.visitorId);
          if (!id || !/^[A-Za-z0-9-]{1,64}$/.test(id)) {
            id = crypto.randomUUID ? crypto.randomUUID() : String(Date.now()) + "-" + Math.random().toString(36).slice(2);
            localStorage.setItem(keys.visitorId, id);
          }
          var count = parseInt(localStorage.getItem(keys.visitCount) || "0", 10) || 0;
          if (!sessionStorage.getItem(keys.sessionCounted)) {
            count += 1;
            localStorage.setItem(keys.visitCount, String(count));
            sessionStorage.setItem(keys.sessionCounted, "1");
          }
          if (count > 1) root.setAttribute("data-returning", "");
        } catch (e) {
          // Storage blocked (private mode, policy): everyone is a first visit.
        }
      })();
    </script>
    <script>
      window.va =
        window.va ||
        function () {
          (window.vaq = window.vaq || []).push(arguments);
        };
    </script>
    <script type="module">
      // Render ```mermaid code blocks as inline SVG diagrams (progressive enhancement).
      // Falls back to the plain code block if the CDN or rendering fails.
      const mermaidBlocks = document.querySelectorAll('pre[data-language="mermaid"]');
      if (mermaidBlocks.length) {
        try {
          const { default: mermaid } = await import(
            "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs"
          );
          mermaid.initialize({ startOnLoad: false, theme: "neutral" });
          for (const block of mermaidBlocks) {
            const code = block.querySelector("code");
            const src = ((code ? code.textContent : block.textContent) || "").trim();
            // Desktop keeps the original orientation (LR flow is compact on wide screens)
            const desktopSrc = src;
            // Mobile forces vertical flow (TD) so it fits the phone width
            const mobileSrc = src.replace(/flowchart\s+LR/i, "flowchart TD");
            const idD = "mmd-d-" + Math.random().toString(36).slice(2);
            const idM = "mmd-m-" + Math.random().toString(36).slice(2);
            const { svg: svgD } = await mermaid.render(idD, desktopSrc);
            const { svg: svgM } = await mermaid.render(idM, mobileSrc);
            function strip(svg) {
              const el = new DOMParser().parseFromString(svg, "image/svg+xml").documentElement;
              el.removeAttribute("width");
              el.removeAttribute("height");
              el.setAttribute("style", "width:100%;height:auto;display:block;");
              return el.outerHTML;
            }
            const htmlD = strip(svgD);
            const htmlM = strip(svgM);
            const wrap = document.createElement("div");
            wrap.className = "mermaid-diagram";
            wrap.innerHTML =
              '<div class="diagram-desktop">' + htmlD + "</div>" +
              '<div class="diagram-mobile">' + htmlM + "</div>";
            wrap.setAttribute("role", "button");
            wrap.setAttribute("tabindex", "0");
            wrap.setAttribute("aria-label", document.documentElement.dataset.mermaidExpand || "");
            wrap.addEventListener("click", () => {
              const mobile = window.matchMedia("(max-width: 768px)").matches;
              openMermaidOverlay(mobile ? htmlM : htmlD);
            });
            wrap.addEventListener("keydown", (e) => {
              if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                const mobile = window.matchMedia("(max-width: 768px)").matches;
                openMermaidOverlay(mobile ? htmlM : htmlD);
              }
            });
            block.replaceWith(wrap);
          }
        } catch (err) {
          console.warn("mermaid render skipped:", err);
        }
      }

      function openMermaidOverlay(svgHtml) {
        const overlay = document.createElement("div");
        overlay.className = "mermaid-overlay";
        overlay.innerHTML =
          '<button type="button" class="mermaid-overlay-close" aria-label="' + (document.documentElement.dataset.mermaidClose || "") + '">&times;</button>' +
          '<div class="mermaid-overlay-body">' + svgHtml + "</div>";
        document.body.appendChild(overlay);
        document.body.style.overflow = "hidden";
        const close = () => { overlay.remove(); document.body.style.overflow = ""; };
        overlay.querySelector(".mermaid-overlay-close").addEventListener("click", close);
        overlay.addEventListener("click", (e) => { if (e.target === overlay) close(); });
        document.addEventListener("keydown", function esc(e) { if (e.key === "Escape") { close(); document.removeEventListener("keydown", esc); } });
      }
    </script>
  </head>
  <body>
    <a class="skip-link button-sm" href="#main">{t("nav.skip")}</a>
    <slot name="header" />
    <main id="main" class="site-shell">
      <slot />
    </main>
    <slot name="footer" />
    <Botardo lang={lang} />
    <ContactDialog lang={lang} />
    <BottomDock lang={lang} />
    <script>
      import { initReveal } from "../scripts/reveal";
      import { initTracking } from "../scripts/track";

      initTracking();
      initReveal();
    </script>
  </body>
</html>
