---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { getLocalizedPath, useTranslations } from "../../../i18n/utils";

const lang = "en";
const t = useTranslations(lang);
const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((project) => ({
    slug: project.data.slug,
    title: project.data[lang].title,
    summary: project.data[lang].summary,
    kind: project.data.kind,
    status: project.data.status,
    year: project.data.year,
    tags: project.data.tags,
  }));
---

<BaseLayout lang={lang} title={t("work.title")} description={t("work.description")}>
  <SiteHeader slot="header" lang={lang} />

  <section class="work">
    <p class="mono label">01 / {t("work.title").toUpperCase()}</p>
    <h1 class="display heading">{t("work.title")}</h1>

    <ul class="cat">
      {
        projects.map((item, i) => (
          <li>
            <a href={getLocalizedPath(lang, `/work/${item.slug}/`)}>
              <span class="row-head">
                <span class="num mono">{String(i + 1).padStart(2, "0")}</span>
                <span class="meta mono">
                  {item.status && <span class="status">{t(`status.${item.status}`)}</span>}
                  {item.status && item.kind && <span class="dot">·</span>}
                  {item.kind && <span class="kind">{t(`kind.${item.kind}`)}</span>}
                  {item.year && <span class="dot">·</span>}
                  {item.year && <span class="year">{item.year}</span>}
                </span>
              </span>
              <span class="title">{item.title}</span>
              <span class="summary">{item.summary}</span>
              {item.tags && item.tags.length > 0 && (
                <span class="tags">
                  {item.tags.map((tag) => (
                    <span class="tag mono">{tag}</span>
                  ))}
                </span>
              )}
              <span class="go mono" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  .work {
    padding: 1rem 0 2rem;
  }
  .label {
    margin: 0 0 0.75rem;
    color: var(--muted-2);
    font-size: 0.8rem;
  }
  .heading {
    margin: 0 0 1.5rem;
    font-size: clamp(2.2rem, 7vw, 3.6rem);
    line-height: 0.95;
  }
  .cat {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cat li {
    position: relative;
    border-top: 2px solid var(--border);
    padding: 1.1rem 0 1.25rem;
  }
  .cat li:last-child {
    border-bottom: 2px solid var(--border);
  }
  .cat a {
    display: grid;
    gap: 0.45rem;
    text-decoration: none;
    color: inherit;
  }
  .row-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .num {
    color: var(--accent);
    font-size: 0.75rem;
  }
  .meta {
    display: inline-flex;
    gap: 0.35rem;
    font-size: 0.7rem;
    align-items: baseline;
  }
  .status {
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 700;
  }
  .dot,
  .kind,
  .year {
    color: var(--muted-2);
  }
  .kind {
    text-transform: uppercase;
  }
  .title {
    font-family: "Archivo Black", sans-serif;
    font-size: clamp(1.3rem, 3.6vw, 1.9rem);
    line-height: 1.05;
    transition: color 0.15s ease;
  }
  .cat a:hover .title {
    color: var(--accent);
  }
  .summary {
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 52ch;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag {
    font-size: 0.62rem;
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 0.12rem 0.4rem;
  }
  .go {
    position: absolute;
    right: 0;
    top: 1.2rem;
    font-size: 1rem;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .cat a:hover .go {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .title,
    .go {
      transition: none;
    }
    .go {
      opacity: 1;
      transform: none;
    }
  }
</style>
