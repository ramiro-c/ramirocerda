---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import WorkflowSplit from "../../components/WorkflowSplit.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "en";
const t = useTranslations(lang);

const nodes = [
  {
    id: "triage",
    number: "01",
    label: "Triage",
    panelTitle: "Triage and framing gate",
    panelBody:
      "Picks at most one Jira card in To Do labeled agent:loop that also has repo:* and env:* labels. Before claiming it, the card must pass the framing gate: an actionable title, business context, and an expected result. If anything is missing, or a Figma link comes without a variant → screen map, it comes back to me as needs_human before any tokens go into design.",
    isHitl: true,
  },
  {
    id: "card-start",
    number: "02",
    label: "card-start",
    panelTitle: "card-start",
    panelBody:
      "Fetches the card through the Atlassian MCP, resolves repo and base branch from its labels, and creates a git worktree with its own branch. The card moves to In Progress and is recorded in a shared state.json, so several loops can run in parallel without colliding.",
    isHitl: false,
  },
  {
    id: "design",
    number: "03",
    label: "Design",
    panelTitle: "Design (architect)",
    panelBody:
      "A subagent follows pstack's architect skill: it sketches types, signatures, and module boundaries before writing code. If the card does not fit in one PR, it slices it with figure-it-out first; if it still does not fit, it escalates.",
    isHitl: false,
  },
  {
    id: "apply",
    number: "04",
    label: "Apply",
    panelTitle: "Apply (poteto-mode)",
    panelBody:
      "A writer implements the sketch in poteto-mode: simple code, small verified changes. Every handoff carries an explicit list of the files it may touch. On bug cards it must show a failing test first (tdd) before touching production code.",
    isHitl: false,
  },
  {
    id: "verify",
    number: "05",
    label: "Verify",
    panelTitle: "Verify (prove it works)",
    panelBody:
      "Another subagent proves the acceptance criteria by running the real behavior. A test that was written but never run does not count as evidence.",
    isHitl: false,
  },
  {
    id: "card-validate",
    number: "06",
    label: "card-validate",
    panelTitle: "card-validate",
    panelBody:
      "Picks gates from the diff: a mutation check that proves each new test can fail, a real run (Bruno against the local backend, headless Playwright on the frontend), and a Figma comparison only when the UI changes. A gate that could not run is not a pass: it stops the loop.",
    isHitl: false,
  },
  {
    id: "card-review",
    number: "07",
    label: "card-review",
    panelTitle: "card-review",
    panelBody:
      "Pre-PR review with one lens per subagent (risk, reliability, readability, resilience) against the card's base branch. Report-only. Every Critical/High finding enters the fix → verify cycle: up to 3 rounds, stopping early if it does not converge or the fix goes out of scope.",
    isHitl: false,
  },
  {
    id: "card-pr",
    number: "08",
    label: "card-pr + interrogate",
    panelTitle: "card-pr + interrogate",
    panelBody:
      "Push, GitHub PR, and an adversarial review with pstack's interrogate: several models (Opus, Sonnet, and one from another family through OpenCode) try to break the change, and only findings that a run reproduces survive. If findings are proven, it runs a single fix round and interrogates again.",
    isHitl: false,
  },
  {
    id: "partners-slack",
    number: "09",
    label: "Partners / Slack",
    panelTitle: "Partners / Slack",
    panelBody:
      "The card moves to Partners/Code Review in Jira and a single notice goes to the backend or frontend Slack channel. Merging is human: the loop never merges.",
    isHitl: true,
  },
] as const;

const thesis =
  "This is how I iterate with AI agents at Libro de pases, built on pstack: an Opus orchestrator hands each phase to a subagent running the model its role calls for, and every card goes through nine stages. None of them advances without evidence from a real run.";
const cta = "Want to see it in action on a real project?";
const ctaLink = "Check the projects";
const panelHint = "Pick a stage to see the details";
---

<BaseLayout lang={lang} title={t("workflow.title")} description={thesis}>
  <SiteHeader slot="header" lang={lang} />

  <section class="workflow">
    <p class="eyebrow caption-3">{t("workflow.eyebrow")}</p>
    <h1 class="heading-1">{t("workflow.title")}</h1>
    <p class="thesis body-3">{thesis}</p>

    <WorkflowSplit
      nodes={nodes}
      hitlLabel={t("workflow.legend.hitl")}
      panelHint={panelHint}
      stagesLabel={t("workflow.stagesLabel")}
    />

    <section class="how-terminates">
      <h2 class="section-label caption-3">{t("workflow.howTerminatesLabel")}</h2>
      <p class="terminates-text body-6">{t("workflow.howTerminates")}</p>
    </section>

    <div class="cta-block">
      <p class="cta-text body-6">{cta}</p>
      <a class="cta-primary" href="/en/work/">
        {ctaLink}
      </a>
    </div>
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  .workflow {
    padding: var(--space-200) 0 var(--space-600);
  }
  .eyebrow {
    margin: 0 0 var(--space-75);
    color: var(--muted-2);
  }
  .workflow h1 {
    margin: 0 0 var(--space-200);
  }
  .thesis {
    max-width: 680px;
    margin: 0 0 var(--space-200);
    color: var(--muted);
  }
  .section-label {
    margin: 0 0 var(--space-75);
    color: var(--muted-2);
  }
  .how-terminates {
    margin: var(--space-300) 0;
    padding-top: var(--space-200);
    border-top: 1px solid var(--border);
  }
  .terminates-text {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
  }
  .cta-block {
    display: grid;
    justify-items: start;
    gap: var(--space-100);
    margin: var(--space-400) 0 0;
    padding: var(--space-300);
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    background: var(--surface);
  }
  .cta-text {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .workflow h1 {
      font-size: var(--text-4xl);
      line-height: 40px;
    }
  }
</style>
