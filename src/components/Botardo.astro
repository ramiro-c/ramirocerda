---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { landing } from "../i18n/landing";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const offer = landing[lang].botardoOffer;
---

<button
  class="botardo-island"
  type="button"
  aria-label={t("botardo.open")}
  aria-controls="botardoDialog"
  aria-expanded="false"
  data-botardo-island
>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M20 15.5a2 2 0 0 1-2 2H8l-4 3v-3H6a2 2 0 0 1-2-2v-9.5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2z"
      fill="currentColor"
    />
    <path d="M8 9.5h8M8 12.5h5.5" stroke="var(--bg)" stroke-width="1.5" stroke-linecap="round" />
  </svg>
</button>

<section
  class="botardo-modal"
  id="botardoDialog"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-labelledby="botardoTitle"
  data-retry-label={t("botardo.retry")}
  data-pending-text={t("botardo.pending")}
  data-error-timeout={t("botardo.errorTimeout")}
  data-error-network={t("botardo.errorNetwork")}
  data-error-rate-limited={t("botardo.errorRateLimited")}
  data-error-server={t("botardo.errorServer")}
  data-offer-text={offer.text}
  data-offer-button={offer.button}
  inert
>
  <header class="botardo-header">
    <div class="botardo-header-title">
      <span class="botardo-mark caption-3" aria-hidden="true">
        RC
      </span>
      <span id="botardoTitle" class="botardo-title title-4">
        Botardo
      </span>
    </div>
    <button class="botardo-close" type="button" aria-label={t("botardo.close")}>
      ✕
    </button>
  </header>

  <div class="botardo-messages" role="log" aria-live="polite" aria-relevant="additions">
    <div class="botardo-message botardo-assistant botardo-welcome">
      <span class="first-visit-only">{t("botardo.welcome")}</span>
      <span class="returning-only">{t("botardo.welcomeReturning")}</span>
    </div>
    <div class="botardo-typing" hidden aria-label={t("botardo.typing")}>
      <span class="botardo-dot"></span>
      <span class="botardo-dot"></span>
      <span class="botardo-dot"></span>
    </div>
  </div>

  <form class="botardo-inputbar" novalidate>
    <label class="sr-only" for="botardoInput">
      {t("botardo.inputLabel")}
    </label>
    <input
      class="botardo-input"
      id="botardoInput"
      type="text"
      inputmode="text"
      enterkeyhint="send"
      aria-label={t("botardo.inputLabel")}
      placeholder={t("botardo.placeholder")}
      autocomplete="off"
    />
    <button class="botardo-send" type="submit" aria-label={t("botardo.send")}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2z" fill="currentColor" />
      </svg>
    </button>
  </form>
</section>

<script>
  import { shouldOfferContact } from "../scripts/botardo-offer.mjs";
  import { askBotardo, errorText } from "../scripts/botardo-stream.mjs";
  // Production worker by default. For local testing run `wrangler dev --remote`
  // in workers/chat-worker and start the site with
  // PUBLIC_BOTARDO_WORKER_URL=http://localhost:8787 pnpm dev
  const WORKER_URL = import.meta.env.PUBLIC_BOTARDO_WORKER_URL ?? "https://ramirocerda-chat.rami992009.workers.dev";

  // Stable per-conversation ID for OpenCode Go (x-opencode-session): reused
  // across messages in the same tab so the upstream can route and cache.
  function getBotardoSessionId() {
    const KEY = "botardo:sessionId";
    try {
      let id = sessionStorage.getItem(KEY);
      if (!id) {
        id = crypto.randomUUID();
        sessionStorage.setItem(KEY, id);
      }
      return id;
    } catch {
      return crypto.randomUUID();
    }
  }
  const botardoSessionId = getBotardoSessionId();

  // Two keys, on purpose. `botardo:history` is the LLM context window sent to
  // the worker (short). `botardo:transcript` is what the visitor sees, so the
  // conversation survives the full page load of a normal internal navigation.
  const HISTORY_KEY = "botardo:history";
  const TRANSCRIPT_KEY = "botardo:transcript";
  const MAX_HISTORY_TURNS = 10;
  const MAX_TRANSCRIPT_MESSAGES = 40;

  function loadStoredMessages(key) {
    try {
      const raw = sessionStorage.getItem(key);
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];
      return parsed.filter(
        (entry) =>
          entry &&
          typeof entry === "object" &&
          (entry.role === "user" || entry.role === "assistant") &&
          typeof entry.content === "string" &&
          entry.content.trim().length > 0,
      );
    } catch {
      return [];
    }
  }

  function persistMessages(key, list, limit) {
    try {
      sessionStorage.setItem(key, JSON.stringify(list.slice(-limit)));
    } catch {
      // sessionStorage unavailable
    }
  }

  let conversationHistory = loadStoredMessages(HISTORY_KEY);
  let transcript = loadStoredMessages(TRANSCRIPT_KEY);

  function persistConversationHistory() {
    persistMessages(HISTORY_KEY, conversationHistory, MAX_HISTORY_TURNS);
  }

  function persistTranscript() {
    persistMessages(TRANSCRIPT_KEY, transcript, MAX_TRANSCRIPT_MESSAGES);
  }

  // Panel state (open/closed + unsent draft) and the message that was in flight
  // when the visitor navigated away. Same reasoning as the transcript: an MPA
  // page load wipes the widget, so it has to rebuild itself from storage.
  const UI_KEY = "botardo:ui";
  const PENDING_KEY = "botardo:pending";

  function loadUiState() {
    try {
      const parsed = JSON.parse(sessionStorage.getItem(UI_KEY) || "null");
      if (!parsed || typeof parsed !== "object") return { open: false, draft: "" };
      return {
        open: parsed.open === true,
        draft: typeof parsed.draft === "string" ? parsed.draft : "",
      };
    } catch {
      return { open: false, draft: "" };
    }
  }

  function readPendingMessage() {
    try {
      return sessionStorage.getItem(PENDING_KEY) || "";
    } catch {
      return "";
    }
  }

  function setPendingMessage(text) {
    try {
      if (text) sessionStorage.setItem(PENDING_KEY, text);
      else sessionStorage.removeItem(PENDING_KEY);
    } catch {
      // sessionStorage unavailable
    }
  }

  const TRUSTED_LINK_HOSTS = new Set(["ramirocerda.com.ar", "www.ramirocerda.com.ar", "ramirocerda.vercel.app"]);

  const modal = document.getElementById("botardoDialog");
  const islandButton = document.querySelector("[data-botardo-island]");
  const closeButton = modal?.querySelector(".botardo-close");
  const messages = modal?.querySelector(".botardo-messages");
  const typingIndicator = modal?.querySelector(".botardo-typing");
  const input = modal?.querySelector(".botardo-input");
  const form = modal?.querySelector(".botardo-inputbar");
  const openTriggers = Array.from(document.querySelectorAll("[data-open-botardo]"));

  if (!modal || !islandButton || !closeButton || !messages || !typingIndicator || !input || !form) {
    throw new Error("Botardo widget could not initialize.");
  }

  const focusableSelector = [
    "button:not([disabled])",
    "input:not([disabled])",
    "a[href]",
    "[tabindex]:not([tabindex='-1'])",
  ].join(",");

  let isOpen = false;
  let lastFailedMessage = "";
  let savedScrollY = 0;
  let scrollLocked = false;
  let lastFocusedElement = null;

  const isMobile = () => window.matchMedia("(max-width: 768px)").matches;
  const prefersReducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function persistUiState() {
    try {
      sessionStorage.setItem(UI_KEY, JSON.stringify({ open: isOpen, draft: input.value }));
    } catch {
      // sessionStorage unavailable
    }
  }

  function setExpandedState(expanded) {
    islandButton.setAttribute("aria-expanded", String(expanded));
    for (const trigger of openTriggers) {
      trigger.setAttribute("aria-expanded", String(expanded));
    }
  }

  function lockBodyScroll() {
    if (scrollLocked) return;
    savedScrollY = window.scrollY;
    document.body.style.position = "fixed";
    document.body.style.top = `-${savedScrollY}px`;
    document.body.style.left = "0";
    document.body.style.right = "0";
    scrollLocked = true;
  }

  function unlockBodyScroll() {
    if (!scrollLocked) return;
    document.body.style.position = "";
    document.body.style.top = "";
    document.body.style.left = "";
    document.body.style.right = "";
    window.scrollTo(0, savedScrollY);
    scrollLocked = false;
  }

  function getFocusableElements() {
    return Array.from(modal.querySelectorAll(focusableSelector)).filter((el) => {
      return el instanceof HTMLElement && !el.hasAttribute("disabled") && el.offsetParent !== null;
    });
  }

  function scrollMessagesToBottom(behavior = "auto") {
    messages.scrollTo({ top: messages.scrollHeight, behavior });
  }

  function updateModalState(open, { focus = true } = {}) {
    isOpen = open;
    modal.classList.toggle("is-open", open);
    modal.setAttribute("aria-hidden", String(!open));
    modal.toggleAttribute("inert", !open);
    setExpandedState(open);
    persistUiState();

    if (open) {
      if (isMobile()) {
        lockBodyScroll();
      }
      if (focus) {
        requestAnimationFrame(() => {
          if (isMobile()) {
            closeButton.focus({ preventScroll: true });
          } else {
            input.focus({ preventScroll: true });
          }
        });
      }
      scrollMessagesToBottom("auto");
      return;
    }

    unlockBodyScroll();
    if (lastFocusedElement instanceof HTMLElement) {
      lastFocusedElement.focus({ preventScroll: true });
    }
  }

  function openBotardo(source = null) {
    lastFocusedElement = source instanceof HTMLElement ? source : document.activeElement;
    if (isOpen) {
      updateModalState(true);
      return;
    }
    updateModalState(true);
  }

  function closeBotardo() {
    if (!isOpen) return;
    updateModalState(false);
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function parseSafeHttpUrl(raw) {
    try {
      const url = new URL(raw);
      if (url.protocol !== "http:" && url.protocol !== "https:") return null;
      return url;
    } catch {
      return null;
    }
  }

  function linkifyToken(raw) {
    const token = raw.replace(/[),.;!?]+$/u, "");
    const suffix = raw.slice(token.length);

    if (token.startsWith("/") && !token.startsWith("//")) {
      if (/^\/[a-zA-Z0-9/_\-.?#=&%]*$/.test(token)) {
        return `<a href="${escapeHtml(token)}">${escapeHtml(token)}</a>${suffix}`;
      }
      return escapeHtml(raw);
    }

    const parsed = parseSafeHttpUrl(token);
    if (!parsed) return escapeHtml(raw);

    const host = parsed.hostname.toLowerCase();
    const href = escapeHtml(parsed.href);
    const label = escapeHtml(token);
    if (TRUSTED_LINK_HOSTS.has(host)) {
      return `<a href="${href}">${label}</a>${suffix}`;
    }
    return `<a href="${href}" target="_blank" rel="noopener noreferrer">${label}</a>${suffix}`;
  }

  function renderMarkdown(text) {
    const raw = String(text);
    const urlPattern = /(?<![\w./%-])(https?:\/\/\S+|\/[a-zA-Z0-9/_\-.?#=&%]+)/g;
    let html = "";
    let lastIndex = 0;
    for (const match of raw.matchAll(urlPattern)) {
      const index = match.index ?? 0;
      html += escapeHtml(raw.slice(lastIndex, index));
      html += linkifyToken(match[0]);
      lastIndex = index + match[0].length;
    }
    html += escapeHtml(raw.slice(lastIndex));

    html = html.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");
    html = html.replace(/__(.+?)__/g, "<strong>$1</strong>");
    html = html.replace(/(?<!\w)\*(.+?)\*(?!\w)/g, "<em>$1</em>");
    html = html.replace(/`(.+?)`/g, "<code>$1</code>");

    return html
      .split(/\n\n+/)
      .map((chunk) => {
        const block = chunk.trim();
        if (!block) return "";
        if (block.match(/^[-*]\s/m)) {
          const items = block.split(/\n/).map((line) => {
            const trimmed = line.replace(/^[-*]\s/, "");
            return `<li>${trimmed}</li>`;
          });
          return `<ul>${items.join("")}</ul>`;
        }
        return `<p>${block.replace(/\n/g, "<br>")}</p>`;
      })
      .join("");
  }

  function appendMessage(text, role, { scroll = true } = {}) {
    const message = document.createElement("div");
    message.className = `botardo-message botardo-${role}`;
    if (role === "assistant") {
      message.innerHTML = renderMarkdown(text);
    } else {
      message.textContent = text;
    }
    messages.insertBefore(message, typingIndicator);
    if (scroll) scrollMessagesToBottom(prefersReducedMotion() ? "auto" : "smooth");
    return message;
  }

  // Internal links are full page loads (no client router), so every navigation
  // re-runs this script against an empty message list. Replay what the visitor
  // already sees instead of showing a blank chat over a warm LLM context.
  function hydrateTranscript() {
    if (!transcript.length) return;

    const welcome = messages.querySelector(".botardo-welcome");
    if (welcome) welcome.hidden = true;

    // Announcements are for the live exchange, not for the replay on load.
    const live = messages.getAttribute("aria-live");
    messages.setAttribute("aria-live", "off");

    for (const entry of transcript) {
      appendMessage(entry.content, entry.role, { scroll: false });
    }

    messages.setAttribute("aria-live", live || "polite");

    if (transcript[transcript.length - 1]?.offerContact === true) {
      appendContactOffer();
    }

    scrollMessagesToBottom("auto");
  }

  // Hire intent comes from the worker's LLM router (PR #20) as
  // `offerContact: true`. Offer the shared contact form (lead origin
  // "botardo"). UI only, never added to the chat history.
  function appendContactOffer() {
    if (messages.querySelector(".botardo-offer")) return;
    const offer = document.createElement("div");
    offer.className = "botardo-message botardo-assistant botardo-offer";
    const text = document.createElement("p");
    text.textContent = modal.getAttribute("data-offer-text") || "";
    const button = document.createElement("button");
    button.type = "button";
    button.className = "cta-primary botardo-offer-button";
    button.dataset.ctaId = "botardo_offer";
    button.dataset.ctaPosition = "chat";
    button.textContent = modal.getAttribute("data-offer-button") || "";
    button.addEventListener("click", () => {
      closeBotardo();
      document.dispatchEvent(new CustomEvent("contact:open", { detail: { origin: "botardo" } }));
    });
    offer.append(text, button);
    messages.insertBefore(offer, typingIndicator);
    scrollMessagesToBottom(prefersReducedMotion() ? "auto" : "smooth");
  }

  function showError(text) {
    const existingError = messages.querySelector(".botardo-error");
    if (existingError) existingError.remove();

    const error = document.createElement("div");
    error.className = "botardo-message botardo-error";
    error.setAttribute("role", "alert");
    error.textContent = text;

    error.appendChild(document.createElement("br"));

    const retryButton = document.createElement("button");
    retryButton.className = "botardo-retry";
    retryButton.type = "button";
    retryButton.textContent = modal.getAttribute("data-retry-label") || "Retry";
    retryButton.addEventListener("click", retryMessage);

    error.appendChild(retryButton);
    messages.insertBefore(error, typingIndicator);
    scrollMessagesToBottom("smooth");
  }

  async function sendMessage(messageOverride = "") {
    const text = (messageOverride || input.value).trim();
    if (!text) {
      input.classList.add("is-error");
      window.setTimeout(() => input.classList.remove("is-error"), 500);
      return;
    }

    input.disabled = true;

    const sendButton = form.querySelector(".botardo-send");
    if (sendButton instanceof HTMLButtonElement) {
      sendButton.disabled = true;
    }

    appendMessage(text, "user");
    input.value = "";
    persistUiState();
    setPendingMessage(text);
    typingIndicator.hidden = false;
    scrollMessagesToBottom("auto");

    let streamedMessage = null;
    try {
      // Streams the reply: the typing indicator stays until the first token, then
      // the message grows in place. Old workers / errors answer JSON (see botardo-stream.mjs).
      const data = await askBotardo({
        url: `${WORKER_URL}/ask`,
        payload: {
          message: text,
          sessionId: botardoSessionId,
          history: conversationHistory.slice(-MAX_HISTORY_TURNS),
        },
        onDelta: (_chunk, soFar) => {
          if (!streamedMessage) {
            typingIndicator.hidden = true;
            streamedMessage = appendMessage(soFar, "assistant");
          } else {
            streamedMessage.innerHTML = renderMarkdown(soFar);
            scrollMessagesToBottom("auto");
          }
        },
      });

      typingIndicator.hidden = true;
      const offerContact = shouldOfferContact(data);
      if (streamedMessage) streamedMessage.innerHTML = renderMarkdown(data.reply);
      else appendMessage(data.reply, "assistant");
      if (offerContact) appendContactOffer();
      conversationHistory.push({ role: "user", content: text });
      conversationHistory.push({ role: "assistant", content: data.reply });
      conversationHistory = conversationHistory.slice(-MAX_HISTORY_TURNS);
      persistConversationHistory();
      transcript.push({ role: "user", content: text });
      transcript.push({
        role: "assistant",
        content: data.reply,
        ...(offerContact ? { offerContact: true } : {}),
      });
      transcript = transcript.slice(-MAX_TRANSCRIPT_MESSAGES);
      persistTranscript();
      setPendingMessage("");
      lastFailedMessage = "";
    } catch (error) {
      typingIndicator.hidden = true;
      // Drop a half-streamed reply: the retry asks again from scratch.
      streamedMessage?.remove();
      lastFailedMessage = text;
      showError(
        errorText(error instanceof Error && "code" in error ? String(error.code) : "NETWORK", {
          timeout: modal.getAttribute("data-error-timeout") || "Timeout",
          network: modal.getAttribute("data-error-network") || "Network error",
          rateLimited: modal.getAttribute("data-error-rate-limited") || "Rate limited",
          server: modal.getAttribute("data-error-server") || "Server error",
        }),
      );
    } finally {
      input.disabled = false;
      if (sendButton instanceof HTMLButtonElement) {
        sendButton.disabled = false;
      }
      if (!isMobile()) {
        input.focus({ preventScroll: true });
      }
    }
  }

  function retryMessage() {
    const existingError = messages.querySelector(".botardo-error");
    if (existingError) existingError.remove();
    if (lastFailedMessage) {
      input.value = lastFailedMessage;
      sendMessage(lastFailedMessage);
    }
  }

  function onOpenTriggerClick(event) {
    event.preventDefault();
    const trigger = event.currentTarget instanceof HTMLElement ? event.currentTarget : null;
    openBotardo(trigger);
    // Demo chips: data-botardo-prompt sends a sample question right away.
    const prompt = trigger?.dataset.botardoPrompt;
    if (prompt && !input.disabled) sendMessage(prompt);
  }

  for (const trigger of openTriggers) {
    trigger.addEventListener("click", onOpenTriggerClick);
  }

  islandButton.addEventListener("click", () => {
    if (isOpen) {
      closeBotardo();
      return;
    }
    openBotardo(islandButton);
  });

  closeButton.addEventListener("click", closeBotardo);

  // Restore the widget session: draft text, replayed messages, panel state and
  // an interrupted question. An internal link is a full page load, so without
  // this the chat starts blank on every page.
  const uiState = loadUiState();
  input.value = uiState.draft;

  hydrateTranscript();

  // Desktop only: on mobile an open panel locks body scroll, so restoring it on
  // a fresh page would trap the visitor at the top of the document.
  if (uiState.open && !isMobile()) {
    updateModalState(true, { focus: false });
  }

  const pendingMessage = readPendingMessage();
  if (pendingMessage) {
    lastFailedMessage = pendingMessage;
    showError(modal.getAttribute("data-pending-text") || "I didn't finish replying. Try again.");
  }

  document.addEventListener("keydown", (event) => {
    if (!isOpen) return;
    if (event.key === "Escape") {
      event.preventDefault();
      closeBotardo();
      return;
    }

    if (event.key !== "Tab") return;

    const focusableElements = getFocusableElements();
    if (!focusableElements.length) return;

    const firstElement = focusableElements[0];
    const lastElement = focusableElements[focusableElements.length - 1];

    if (event.shiftKey && document.activeElement === firstElement) {
      event.preventDefault();
      lastElement.focus();
      return;
    }

    if (!event.shiftKey && document.activeElement === lastElement) {
      event.preventDefault();
      firstElement.focus();
    }
  });

  form.addEventListener("submit", (event) => {
    event.preventDefault();
    sendMessage();
  });

  input.addEventListener("input", persistUiState);

  input.addEventListener("keydown", (event) => {
    if (event.key === "Enter" && !event.shiftKey) {
      event.preventDefault();
      sendMessage();
    }
  });

  modal.addEventListener("transitionend", () => {
    if (!isOpen) {
      typingIndicator.hidden = true;
    }
  });
</script>

{/* is:global: JS appends .botardo-message nodes without Astro's scoped data attr */}
<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .botardo-island {
    position: fixed;
    right: calc(var(--botardo-inset) + env(safe-area-inset-right));
    bottom: calc(var(--botardo-inset) + var(--dock-bar-offset, 0px) + env(safe-area-inset-bottom));
    width: var(--botardo-size);
    height: var(--botardo-size);
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background: var(--accent);
    color: var(--bg);
    cursor: pointer;
    z-index: var(--z-dock);
    /* Dark surfaces read elevation through a ring, not a drop shadow. */
    box-shadow: 0 0 0 1px var(--border-strong);
    transition:
      transform var(--dur-color) var(--ease-out),
      background-color var(--dur-color) var(--ease-out),
      color var(--dur-color) var(--ease-out);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .botardo-island:hover {
    transform: translateY(-1px);
  }

  .botardo-island:active {
    transform: translateY(0) scale(0.98);
  }

  .botardo-island svg {
    width: 24px;
    height: 24px;
  }

  .botardo-modal {
    position: fixed;
    right: calc(var(--space-200) + env(safe-area-inset-right));
    bottom: calc(var(--space-900) + var(--dock-bar-offset, 0px) + env(safe-area-inset-bottom));
    width: min(400px, calc(100vw - var(--space-400)));
    height: min(560px, calc(100vh - var(--space-900) - var(--dock-bar-offset, 0px)));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    z-index: var(--z-widget);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transform: translateY(var(--space-75)) scale(0.985);
    transition:
      opacity var(--dur-color) var(--ease-out),
      transform var(--dur-move) var(--ease-out),
      visibility 0s linear var(--dur-move);
    /* Dark surfaces read elevation through a ring, not a drop shadow. */
    box-shadow: 0 0 0 1px var(--border-strong);
  }

  .botardo-modal.is-open {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transform: translateY(0) scale(1);
    transition:
      opacity var(--dur-color) var(--ease-out),
