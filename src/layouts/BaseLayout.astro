---
import "../styles/global.css";
import Botardo from "../components/Botardo.astro";
import { switchLangPath } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  lang: "es" | "en";
}

const { title, description, lang } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogLocale = lang === "es" ? "es_AR" : "en_US";
const ogLocaleAlternate = lang === "es" ? "en_US" : "es_AR";
const esURL = new URL(switchLangPath(Astro.url.pathname, "es"), Astro.site);
const enURL = new URL(switchLangPath(Astro.url.pathname, "en"), Astro.site);
const homeURL = new URL(lang === "es" ? "/es/" : "/en/", Astro.site);
const inLanguage = lang === "es" ? "es-AR" : "en-US";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${homeURL.href}#website`,
      name: "Ramiro Cerdá",
      url: homeURL.href,
      inLanguage,
      publisher: { "@id": `${homeURL.href}#person` },
    },
    {
      "@type": "Person",
      "@id": `${homeURL.href}#person`,
      name: "Ramiro Cerdá",
      url: homeURL.href,
      jobTitle: "Senior Full-Stack Developer",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Buenos Aires",
        addressCountry: "AR",
      },
      sameAs: [
        "https://github.com/ramiro-c",
        "https://www.linkedin.com/in/cerdaramiro/",
      ],
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F5F1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/rc.png" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="es" href={esURL} />
    <link rel="alternate" hreflang="en" href={enURL} />
    <link rel="alternate" hreflang="x-default" href={new URL("/es/", Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ramiro Cerdá" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og.png", Astro.site)} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script>
      window.va =
        window.va ||
        function () {
          (window.vaq = window.vaq || []).push(arguments);
        };
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main" class="site-shell">
      <slot />
    </main>
    <slot name="footer" />
    <Botardo lang={lang} />
  </body>
</html>
