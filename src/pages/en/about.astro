---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import AboutDossier from "../../components/AboutDossier.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "en";
const t = useTranslations(lang);
const yearsExp = new Date().getFullYear() - 2020;

const copy = {
  en: {
    bio: `Tech lead and full stack developer based in Buenos Aires. I lead development at Libro de Pases and take AI agents to production. Systems Engineer (UTN, 2023).`,
    personal: [
      "I read a lot. Mostly hard science fiction, horror and dystopias. I prefer used books: I like finding the notes someone left behind and the smell of an old book. My favorites are 1984, Brave New World, Neuromancer and Pet Sematary.",
      "I did martial arts my whole life, BJJ, taekwondo, MMA and kickboxing. Right now I am fully into the gym. When I can I escape to the mountains, go trekking and just watch natural events. Rivers, the sun, the moon, the stars, bees. I also like looking into bugs and getting properly dirty with my kids.",
      "On screen, Interstellar is my favorite, and I, Robot and Game of Thrones stuck with me. For music I am a rock guy: Pity Álvarez, Viejas Locas and Molchat Doma, that Belarusian post punk I played on loop while reading 1984. I think that is why the book hit me so hard.",
    ],
    roles: [
      "LDP — RN Dev → React Dev → Tech Lead Full stack · 4 years",
      "DevGAM — Full stack freelance: multi industry management systems (PHP, JS, MySQL)",
      "UTN FRLP / ICT Secretariat — Full stack: administrative workflows (Laravel, Vue)",
      "New Logic — React freelance: blog with marketplace on GCP",
    ],
    education: "UTN — Systems Information Engineering (2023) · Coderhouse — AI Engineering (2026)",
    skills: [
      {
        label: "Frontend & Mobile",
        items:
          "React 19, React Native, TypeScript, Expo, Zustand, React Query, Vue.js, Tailwind CSS v4, Shadcn/ui",
      },
      {
        label: "Backend, Cloud & Data",
        items:
          "Node.js, NestJS, Python, FastAPI, MySQL, PostgreSQL, GCP (Vertex AI, Cloud Run), Cloudflare Workers, REST APIs",
      },
      {
        label: "AI & Automation",
        items:
          "Google ADK, LangGraph, Workers AI, Gemini, Anthropic, n8n, OpenRouter, Cursor / Claude Code",
      },
      {
        label: "DevOps, Quality & Testing",
        items:
          "CI/CD, Docker, Git, Sentry, New Relic, Pytest, Jest, Vitest, Playwright, SonarQube",
      },
      {
        label: "Process",
        items: "SCRUM, GitFlow, code reviews, Jira, Confluence",
      },
    ],
  },
} as const;

const about = copy[lang];
---

<BaseLayout lang={lang} title={t("about.title")} description={about.bio}>
  <SiteHeader slot="header" lang={lang} />

  <section class="about">
    <h1 class="heading-1">{t("about.title")}</h1>
    <AboutDossier lang={lang} yearsExp={yearsExp} copy={about} />
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  .about {
    padding: var(--space-200) 0 var(--space-600);
  }
  .about h1 {
    margin: 0 0 var(--space-300);
  }
  @media (max-width: 720px) {
    .about h1 {
      font-size: var(--text-4xl);
      line-height: 40px;
    }
  }
</style>
