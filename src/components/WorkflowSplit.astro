---
// Workflow step browser: compact numbered rows on the left; sticky detail
// panel on the right filled by a small inline script on click.
interface Props {
  nodes: {
    id: string;
    number: string;
    label: string;
    role: string;
    panelTitle: string;
    panelBody: string;
    isHitl?: boolean;
  }[];
  hitlLabel: string;
  panelHint: string;
}
const { nodes, hitlLabel, panelHint } = Astro.props;
const returns: Record<number, string> = {
  3: "↩ fix-cycle → 03",
  5: "↩ escalation → 03",
};
---

<div class="split" data-wf-c>
  <div class="s-rows">
    <ul class="c-rows">
      {
        nodes.map((node, i) => (
          <li>
            <button
              type="button"
              class="c-row"
              data-wf-row={node.id}
              data-wf-title={node.panelTitle}
              data-wf-body={node.panelBody}
              data-wf-hitl={node.isHitl ? "1" : ""}
            >
              <span class="num mono caption-4">{node.number}</span>
              <span class="label body-1">{node.label}</span>
              {node.isHitl && <span class="pill caption-3">{hitlLabel}</span>}
              <span class="arrow">→</span>
            </button>
            {returns[i] && <p class="c-return mono caption-5">{returns[i]}</p>}
            <div class="row-detail">
              <p class="d-title title-1">{node.panelTitle}</p>
              <p class="d-body body-6">{node.panelBody}</p>
              {node.isHitl && <span class="pill caption-3">{hitlLabel}</span>}
            </div>
          </li>
        ))
      }
    </ul>
  </div>

  <aside class="s-panel" data-wf-panel>
    <p class="panel-placeholder body-6" data-wf-placeholder>
      <span aria-hidden="true">→</span>
      {panelHint}
    </p>
    <div class="panel-content" data-wf-content hidden>
      <p class="p-title title-1" data-wf-out-title></p>
      <p class="p-body body-6" data-wf-out-body></p>
      <span class="pill caption-3" data-wf-out-hitl hidden>{hitlLabel}</span>
    </div>
  </aside>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-wf-c]");
    if (!root) return;
    const rows = root.querySelectorAll("[data-wf-row]");
    const panel = root.querySelector("[data-wf-panel]");
    const placeholder = root.querySelector("[data-wf-placeholder]");
    const content = root.querySelector("[data-wf-content]");
    const outTitle = root.querySelector("[data-wf-out-title]");
    const outBody = root.querySelector("[data-wf-out-body]");
    const outHitl = root.querySelector("[data-wf-out-hitl]");

    const select = (btn) => {
      rows.forEach((r) => r.classList.toggle("active", r === btn));
      if (!panel || !content || !outTitle || !outBody || !outHitl) return;
      outTitle.textContent = btn.getAttribute("data-wf-title") || "";
      outBody.textContent = btn.getAttribute("data-wf-body") || "";
      outHitl.hidden = !btn.getAttribute("data-wf-hitl");
      if (placeholder) placeholder.hidden = true;
      content.hidden = false;
    };

    rows.forEach((r) => r.addEventListener("click", () => select(r)));
    // Default: first row preselected.
    if (rows.length) select(rows[0]);
  })();
</script>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  .split {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-300);
    margin: var(--space-200) 0 0;
    align-items: start;
  }
  .s-rows {
    min-width: 0;
  }
  .c-rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .c-rows li {
    border-top: 1px solid var(--border);
    padding: var(--space-100) 0;
  }
  .c-return {
    margin: var(--space-50) 0 0;
    color: var(--muted-2);
  }
  .c-row {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-100);
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
    color: var(--text);
    transition: transform var(--dur-color) var(--ease-out);
  }
  .c-row:active {
    transform: scale(0.98);
  }
  .label {
    min-width: 0;
  }
  .num {
    color: var(--muted-2);
  }
  .label {
    color: var(--text);
    transition: color var(--dur-color) var(--ease-out);
  }
  .c-row:hover .label,
  .c-row.active .label {
    color: var(--accent-text);
  }
  .arrow {
    margin-left: auto;
    opacity: 0;
    transition: opacity var(--dur-color) var(--ease-out);
  }
  .c-row:hover .arrow,
  .c-row.active .arrow {
    opacity: 1;
    color: var(--accent);
  }
  .pill {
    padding: var(--space-25) var(--space-75);
    color: var(--accent-text);
    border: 1px solid var(--accent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--accent) 10%, var(--bg));
  }
  .s-panel {
    position: sticky;
    top: var(--space-900);
    padding: var(--space-300);
    min-height: 12rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    background: var(--surface);
  }
  .panel-placeholder {
    margin: 0;
    color: var(--muted-2);
  }
  .p-title {
    margin: 0 0 var(--space-100);
  }
  .p-body {
    margin: 0 0 var(--space-100);
    color: var(--muted);
  }
  .row-detail {
    display: none;
  }
  .d-title {
    margin: 0 0 var(--space-50);
  }
  .d-body {
    margin: 0 0 var(--space-50);
    color: var(--muted);
  }
  @media (max-width: 768px) {
    .split {
      grid-template-columns: 1fr;
    }
    .s-panel {
      display: none;
    }
    /* Arrow is a desktop-only affordance pointing at the side panel. */
    .arrow {
      display: none;
    }
    /* Accordion: only the row holding .active (toggled by the script) expands. */
    .row-detail {
      display: none;
    }
    li:has(.active) .row-detail {
      display: block;
      margin: var(--space-100) 0 var(--space-25);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .arrow,
    .label {
      transition: none;
    }
    .c-row:active {
      transform: none;
    }
  }
</style>
