---
import type { Lang } from "../i18n/ui";
import { getLocalizedPath, useTranslations } from "../i18n/utils";
import { landing } from "../i18n/landing";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer site-shell">
  <p>{t("footer.line")} · <span>{year}</span></p>
  <p class="footer-links">
    <a href="https://github.com/ramiro-c" rel="noreferrer" target="_blank">GitHub</a>
    <span aria-hidden="true">·</span>
    <a
      href="https://www.linkedin.com/in/cerdaramiro/"
      rel="noreferrer"
      target="_blank">LinkedIn</a
    >
    <span aria-hidden="true">·</span>
    <a href="mailto:rami992009@gmail.com">{t("footer.email")}</a>
    <span aria-hidden="true">·</span>
    <a href={getLocalizedPath(lang, "/privacy/")}>{landing[lang].notice.link}</a>
  </p>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    padding: 1.5rem 0 3rem;
    border-top: 1px solid var(--border);
    color: var(--muted-2);
    font-size: 0.9rem;
  }

  .footer-links {
    margin-top: 0.35rem;
    font-size: 0.85rem;
  }

  .footer-links a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
</style>
