---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WorkflowSplit from "../components/WorkflowSplit.astro";
import { useTranslations } from "../i18n/utils";

const lang = "es";
const t = useTranslations(lang);

const nodes = [
  {
    id: "triage",
    number: "01",
    label: "Triage",
    panelTitle: "Triage y framing gate",
    panelBody:
      "Toma como máximo una card de Jira en To Do con label agent:loop y labels repo:* y env:*. Antes de reclamarla pasa el framing gate: título accionable, contexto de negocio y resultado esperado. Si falta algo, o si trae un Figma sin el mapeo variante → pantalla, vuelve a mí como needs_human sin gastar tokens en diseño.",
    isHitl: true,
  },
  {
    id: "card-start",
    number: "02",
    label: "card-start",
    panelTitle: "card-start",
    panelBody:
      "Trae la card por el MCP de Atlassian, resuelve repo y rama base desde los labels y crea un git worktree con su propia rama. La card pasa a In Progress y queda registrada en un state.json compartido, así varios loops corren en paralelo sin pisarse.",
    isHitl: false,
  },
  {
    id: "design",
    number: "03",
    label: "Design",
    panelTitle: "Design (architect)",
    panelBody:
      "Un subagente sigue el skill architect de pstack: bosqueja tipos, firmas y límites de módulos antes de escribir código. Si la card no entra en un solo PR, primero la corta con figure-it-out; si igual no entra, la escala.",
    isHitl: false,
  },
  {
    id: "apply",
    number: "04",
    label: "Apply",
    panelTitle: "Apply (poteto-mode)",
    panelBody:
      "Un writer implementa el bosquejo en poteto-mode: código simple, cambios chicos y verificados. Cada handoff lleva la lista explícita de archivos que puede tocar. En cards de bug primero tiene que mostrar un test en rojo (tdd) antes de tocar código de producción.",
    isHitl: false,
  },
  {
    id: "verify",
    number: "05",
    label: "Verify",
    panelTitle: "Verify (prove it works)",
    panelBody:
      "Otro subagente prueba los criterios de aceptación ejecutando el comportamiento real. Un test escrito pero no corrido no cuenta como evidencia.",
    isHitl: false,
  },
  {
    id: "card-validate",
    number: "06",
    label: "card-validate",
    panelTitle: "card-validate",
    panelBody:
      "Elige los gates según el diff: un mutation check que prueba que cada test nuevo puede fallar, ejecución real (Bruno contra el backend local, Playwright headless en el frontend) y comparación contra Figma solo si cambia UI. Un gate que no pudo correr no es un pass: frena el loop.",
    isHitl: false,
  },
  {
    id: "card-review",
    number: "07",
    label: "card-review",
    panelTitle: "card-review",
    panelBody:
      "Review pre-PR con un lente por subagente (risk, reliability, readability, resilience) contra la rama base de la card. Report-only. Todo hallazgo Critical/High entra al ciclo fix → verify: hasta 3 rondas, y corta antes si no converge o si el fix se sale del alcance.",
    isHitl: false,
  },
  {
    id: "card-pr",
    number: "08",
    label: "card-pr + interrogate",
    panelTitle: "card-pr + interrogate",
    panelBody:
      "Push, PR en GitHub y review adversarial con interrogate de pstack: varios modelos (Opus, Sonnet y uno de otra familia vía OpenCode) intentan romper el cambio, y solo sobreviven los hallazgos que una ejecución reproduce. Si hay hallazgos probados, hace una única ronda de fix y vuelve a interrogar.",
    isHitl: false,
  },
  {
    id: "partners-slack",
    number: "09",
    label: "Partners / Slack",
    panelTitle: "Partners / Slack",
    panelBody:
      "La card pasa a Partners/Code Review en Jira y sale un solo aviso al canal de Slack de backend o frontend. El merge es humano: el loop nunca mergea.",
    isHitl: true,
  },
] as const;

const thesis =
  "Así itero con agentes de IA en Libro de pases, con pstack como base: un orquestador en Opus delega cada fase a un subagente con el modelo que pide su rol, y cada card pasa por nueve etapas. Ninguna avanza sin la evidencia de una ejecución real.";
const cta = "¿Querés verlo en acción en un proyecto real?";
const ctaLink = "Mirá los proyectos";
const panelHint = "Elegí una etapa para ver el detalle";
---

<BaseLayout lang={lang} title={t("workflow.title")} description={thesis}>
  <SiteHeader slot="header" lang={lang} />

  <section class="workflow">
    <p class="eyebrow caption-3">{t("workflow.eyebrow")}</p>
    <h1 class="heading-1">{t("workflow.title")}</h1>
    <p class="thesis body-3">{thesis}</p>

    <WorkflowSplit nodes={nodes} hitlLabel={t("workflow.legend.hitl")} panelHint={panelHint} />

    <section class="how-terminates">
      <h2 class="section-label caption-3">{t("workflow.howTerminatesLabel")}</h2>
      <p class="terminates-text body-6">{t("workflow.howTerminates")}</p>
    </section>

    <div class="cta-block">
      <p class="cta-text body-6">{cta}</p>
      <a class="cta-primary" href="/work/">
        {ctaLink}
      </a>
    </div>
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  .workflow {
    padding: var(--space-200) 0 var(--space-600);
  }
  .eyebrow {
    margin: 0 0 var(--space-75);
    color: var(--muted-2);
  }
  .workflow h1 {
    margin: 0 0 var(--space-200);
  }
  .thesis {
    max-width: 680px;
    margin: 0 0 var(--space-200);
    color: var(--muted);
  }
  .section-label {
    margin: 0 0 var(--space-75);
    color: var(--muted-2);
  }
  .how-terminates {
    margin: var(--space-300) 0;
    padding-top: var(--space-200);
    border-top: 1px solid var(--border);
  }
  .terminates-text {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
  }
  .cta-block {
    display: grid;
    justify-items: start;
    gap: var(--space-100);
    margin: var(--space-400) 0 0;
    padding: var(--space-300);
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    background: var(--surface);
  }
  .cta-text {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .workflow h1 {
      font-size: var(--text-4xl);
      line-height: 40px;
    }
  }
</style>
