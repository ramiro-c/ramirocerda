---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import WorkflowSplit from "../../components/WorkflowSplit.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "en";
const t = useTranslations(lang);

const nodes = [
  {
    id: "triage",
    number: "01",
    label: "Triage",
    panelTitle: "Initial triage",
    panelBody:
      "It picks a card from the To Do backlog with the agent:loop label. I still trigger it myself (no cron): each tick takes at most one card. It classifies the task type and assigns priority.",
    isHitl: false,
  },
  {
    id: "card-start",
    number: "02",
    label: "card-start",
    panelTitle: "card-start",
    panelBody:
      "It creates an isolated worktree with its own branch from the Jira card. It resolves the repo and base branch from the card's labels. Ready to work without touching the main checkout.",
    isHitl: false,
  },
  {
    id: "sdd-auto",
    number: "03",
    label: "SDD auto",
    panelTitle: "SDD auto",
    panelBody:
      "A full 5-phase pipeline: Explore (context), Propose (intent), Spec (requirements + scenarios), Design (technical architecture), Tasks (task breakdown). All generated by agents before touching code.",
    isHitl: true,
  },
  {
    id: "card-review",
    number: "04",
    label: "card-review",
    panelTitle: "card-review",
    panelBody:
      "Pre-PR review using the four 4R lenses (Requirements, Reliability, Readability, Risk). Report-only: it finds issues before opening the PR. It can also simplify code on request.",
    isHitl: false,
  },
  {
    id: "card-pr",
    number: "05",
    label: "card-pr",
    panelTitle: "card-pr",
    panelBody:
      "It pushes the branch and opens the GitHub PR. It does not merge: it leaves the diff ready for the adversarial review of the next step.",
    isHitl: false,
  },
  {
    id: "judgment-day",
    number: "06",
    label: "Judgment Day",
    panelTitle: "Judgment Day",
    panelBody:
      "Blind adversarial review: two agents review the diff independently, compare findings, and issue a verdict. If it finds issues, it goes back to SDD for fix + re-judgment (2 rounds max).",
    isHitl: true,
  },
  {
    id: "partners-slack",
    number: "07",
    label: "Partners / Slack",
    panelTitle: "Partners / Slack",
    panelBody:
      "The card moves to Partners/Code Review in Jira and a single notification goes out to the Slack channel (backend or frontend). Merging is human — the loop never auto-merges.",
    isHitl: false,
  },
] as const;

const thesis =
  "This is how I iterate with AI agents: every card goes through seven connected stages. The loop alternates between autonomous phases and human decision points.";
const cta = "Want to see it in action on a real project?";
const ctaLink = "Check the projects";
const panelHint = "Pick a stage to see the details";
---

<BaseLayout lang={lang} title={t("workflow.title")} description={thesis}>
  <SiteHeader slot="header" lang={lang} />

  <section class="workflow">
    <p class="mono eyebrow">{t("workflow.eyebrow")}</p>
    <h1 class="display">{t("workflow.title")}</h1>
    <p class="thesis">{thesis}</p>

    <WorkflowSplit nodes={nodes} hitlLabel={t("workflow.legend.hitl")} panelHint={panelHint} />

    <section class="how-terminates">
      <h2 class="mono section-label">{t("workflow.howTerminatesLabel")}</h2>
      <p class="terminates-text">{t("workflow.howTerminates")}</p>
    </section>

    <div class="cta-block">
      <p class="cta-text">{cta}</p>
      <a class="btn" href="/en/work/">{ctaLink}</a>
    </div>
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  .workflow {
    padding: 1rem 0 2rem;
  }
  .eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    color: var(--muted-2);
  }
  .display {
    margin: 0 0 0.75rem;
    font-size: clamp(1.6rem, 5vw, 2.4rem);
    line-height: 1.05;
  }
  .thesis {
    max-width: 42rem;
    margin: 0 0 0.5rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.55;
  }
  .section-label {
    margin: 0 0 0.5rem;
    font-size: 0.8rem;
    color: var(--muted-2);
  }
  .how-terminates {
    margin: 1.5rem 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .terminates-text {
    max-width: 44rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .cta-block {
    margin: 2rem 0 0;
    padding: 1.25rem;
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--accent) 4%, var(--bg));
  }
  .cta-text {
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
