---
// Post-hero body of the home page: projects catalog + notes rail (variant B hub),
// with the about/stack intro below. Shared by / (es) and /en/.
import { getCollection } from "astro:content";
import type { Lang } from "../i18n/ui";
import { getLocalizedPath, useTranslations } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const STACK_ITEMS = ["TypeScript", "React", "Astro", "Node.js", "Python", "FastAPI", "PostgreSQL", "Cloudflare"];

const projects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .toSorted((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    slug: p.data.slug,
    title: p.data[lang].title,
    summary: p.data[lang].summary,
    kind: p.data.kind,
    status: p.data.status,
    year: p.data.year,
  }));

const notes = (await getCollection("notes"))
  .filter((n) => n.data.lang === lang && !n.data.draft)
  .toSorted((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .map((n) => ({
    slug: n.data.slug || n.id.replace(/^(es|en)\//, ""),
    title: n.data.title,
    description: n.data.description,
    dateStr: n.data.pubDate.toLocaleDateString(lang === "es" ? "es-AR" : "en-US", {
      timeZone: "UTC",
      day: "2-digit",
      month: "short",
      year: "numeric",
    }),
  }));
---

<div class="hub">
  <span class="band-num mono caption-4" aria-hidden="true">
    04
  </span>
  <div class="hub-main">
    <p class="label caption-3">{t("home.workLabel")}</p>
    <ul class="pj-rail">
      {projects.map((p) => (
        <li>
          <a href={getLocalizedPath(lang, `/work/${p.slug}/`)}>
            <span class="date pj-meta caption-4">
              {p.status && <span class="status">{t(`status.${p.status}`)}</span>}
              {p.status && (
                <span class="dot" aria-hidden="true">
                  {" · "}
                </span>
              )}
              {p.kind && t(`kind.${p.kind}`)}
              {p.year && `${p.status || p.kind ? " · " : ""}${p.year}`}
            </span>
            <span class="pj-title title-3">{p.title}</span>
            <span class="summary body-6">{p.summary}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="rail-more">
      <a class="more-link body-4" href={getLocalizedPath(lang, "/work/")}>
        {t("home.workAll")} →
      </a>
    </p>
  </div>
  <aside class="hub-rail">
    <p class="label caption-3">{t("home.notesLabel")}</p>
    {notes.length === 0 ? (
      <p class="empty body-6">{t("home.notesEmpty")}</p>
    ) : (
      <ul class="note-rail">
        {notes.map((note) => (
          <li>
            <a href={getLocalizedPath(lang, `/notes/${note.slug}/`)}>
              <span class="date mono caption-4">{note.dateStr}</span>
              <span class="note-title title-4">{note.title}</span>
              <span class="summary body-6">{note.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
    <p class="rail-more">
      <a class="more-link body-4" href={getLocalizedPath(lang, "/notes/")}>
        {t("nav.notes")} →
      </a>
    </p>
  </aside>
</div>

<div class="intro">
  <span class="band-num mono caption-4" aria-hidden="true">
    05
  </span>
  <div>
    <p class="label caption-3">{t("home.aboutLabel")}</p>
    <p class="about-text body-3">{t("home.aboutText")}</p>
    <a class="more-link body-4" href={getLocalizedPath(lang, "/about/")}>
      {t("nav.about")} →
    </a>
  </div>
  <div>
    <p class="label caption-3">{t("home.stackLabel")}</p>
    <ul class="stack-list">
      {STACK_ITEMS.map((tech) => (
        <li class="tag caption-4">{tech}</li>
      ))}
    </ul>
  </div>
</div>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  /* The hub shares the editorial frame the bands use: a numbered rail on the
     left and the content in the columns beside it, so the page keeps one spine
     from the hero to the closing block. */
  .hub {
    display: grid;
    grid-template-columns: var(--space-700) minmax(0, 2fr) minmax(0, 1fr);
    column-gap: var(--space-600);
    row-gap: var(--space-400);
    align-items: start;
    padding: var(--space-900) 0;
    border-top: 1px solid var(--border);
  }
  .band-num {
    grid-column: 1;
    grid-row: 1;
    padding-top: var(--space-75);
    color: var(--muted-2);
  }
  .hub-rail {
    position: sticky;
    top: var(--space-900);
  }
  .label {
    margin: 0 0 var(--space-100);
    color: var(--muted-2);
  }
  .empty {
    color: var(--muted);
  }
  .pj-rail {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-300) var(--space-400);
  }
  .pj-rail li {
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-200);
  }
  .pj-rail li a {
    display: grid;
    gap: var(--space-50);
    text-decoration: none;
  }
  .pj-title {
    color: var(--text);
    transition: color var(--dur-color) var(--ease-out);
  }
  .pj-rail li a:hover .pj-title {
    color: var(--accent-text);
  }
  .pj-meta {
    color: var(--muted-2);
  }
  .pj-meta .status {
    color: var(--accent-text);
  }
  .note-rail {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-200);
  }
  .note-rail li a {
    display: grid;
    gap: var(--space-25);
    text-decoration: none;
  }
  .note-title {
    color: var(--text);
    transition: color var(--dur-color) var(--ease-out);
  }
  .note-rail li a:hover .note-title {
    color: var(--accent-text);
  }
  .date {
    color: var(--muted-2);
  }
  .summary {
    color: var(--muted);
  }
  .rail-more {
    margin: var(--space-300) 0 0;
  }
  .intro {
    display: grid;
    grid-template-columns: var(--space-700) minmax(0, 1.2fr) minmax(0, 1fr);
    column-gap: var(--space-600);
    row-gap: var(--space-400);
    padding: var(--space-900) 0;
    border-top: 1px solid var(--border);
  }
  .about-text {
    color: var(--muted);
    margin: 0 0 var(--space-100);
  }
  .stack-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-50);
    padding: 0;
    margin: 0;
  }
  .stack-list .tag {
    padding: var(--space-25) var(--space-75);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--muted);
  }
  .more-link {
    display: inline-block;
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition:
      color var(--dur-color) var(--ease-out),
      transform var(--dur-color) var(--ease-out);
  }
  .more-link:hover {
    color: var(--accent-text);
  }
  .more-link:active {
    transform: scale(0.98);
  }
  @media (max-width: 768px) {
    /* The rail collapses: the number sits above the content so each block still
       opens with a marker instead of losing its spine. */
    .hub,
    .intro {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--space-700) 0;
    }
    .band-num {
      grid-row: auto;
      padding-top: 0;
      margin-bottom: var(--space-50);
    }
    .hub-rail {
      position: static;
      padding-top: var(--space-300);
      border-top: 1px solid var(--border);
    }
    .pj-rail {
      grid-template-columns: 1fr;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pj-title,
    .note-title,
    .more-link {
      transition: none;
    }
    .more-link:active {
      transform: none;
    }
  }
</style>
