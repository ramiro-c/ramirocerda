---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HomeLanding from "../components/HomeLanding.astro";
import { landing } from "../i18n/landing";
import { useTranslations } from "../i18n/utils";

const lang = "es";
const t = useTranslations(lang);
const hero = landing[lang].hero;
---

<BaseLayout lang={lang} title={`${t("home.brand")} · ${hero.headline} ${hero.headlineAccent}`} description={hero.sub}>
  <SiteHeader slot="header" lang={lang} />
  <HomeLanding lang={lang} />
  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>
