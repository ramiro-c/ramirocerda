---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { getLocalizedPath, useTranslations } from "../../../i18n/utils";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  if (!notes.length) return [];

  return Promise.all(
    notes
      .filter((note) => !note.data.draft && note.data.lang === "en")
      .map(async (note) => {
        const otherNotes = notes
          .filter((n) => n.data.lang === "en" && !n.data.draft && n.id !== note.id)
          .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
          .slice(0, 3)
          .map((n) => ({
            slug: n.data.slug || n.id.replace(/^(es|en)\//, ""),
            title: n.data.title,
            dateStr: n.data.pubDate.toLocaleDateString("en-US", { timeZone: "UTC", day: "2-digit", month: "short", year: "numeric" }),
          }));
        const relatedProjectSlugs = note.data.relatedProjects || [];
        const projects = (await getCollection("projects"))
          .filter((p) => relatedProjectSlugs.includes(p.data.slug))
          .map((p) => ({ slug: p.data.slug, title: p.data.en.title, status: p.data.status }));
        return {
          params: { slug: note.data.slug || note.id.replace(/^(es|en)\//, "") },
          props: { note, otherNotes, projects },
        };
      }),
  );
}

const lang = "en";
const t = useTranslations(lang);
const { note, otherNotes, projects } = Astro.props as {
  note: Awaited<ReturnType<typeof getCollection>>[number];
  otherNotes: Array<{ slug: string; title: string; dateStr: string }>;
  projects: Array<{ slug: string; title: string; status?: string }>;
};
const { Content } = await render(note);
---

<BaseLayout lang={lang} title={note.data.title} description={note.data.description}>
  <SiteHeader slot="header" lang={lang} />

  <article class="note">
    <p class="label caption-3"><a class="crumb" href={getLocalizedPath(lang, "/notes/")}>{t("notes.back")}</a> / {note.data.lang.toUpperCase()}</p>
    <h1 class="heading-1">{note.data.title}</h1>
    <p class="summary body-3">{note.data.description}</p>
    <div class="content">
      <Content />
    </div>

    {projects.length > 0 && (
      <section class="related">
        <p class="label caption-3">{t("notes.relatedProjects")}</p>
        <ul class="related-list">
          {projects.map((p) => (
            <li>
              <a href={getLocalizedPath(lang, `/work/${p.slug}/`)}>
                <span class="rel-title title-3">{p.title}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {otherNotes.length > 0 && (
      <section class="related">
        <p class="label caption-3">{t("notes.other")}</p>
        <ul class="related-list">
          {otherNotes.map((n) => (
            <li>
              <a href={getLocalizedPath(lang, `/notes/${n.slug}/`)}>
                <span class="rel-date mono caption-4">{n.dateStr}</span>
                <span class="rel-title title-3">{n.title}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  .note {
    padding: var(--space-200) 0 var(--space-600);
  }
  .label {
    margin: 0 0 var(--space-100);
    color: var(--muted-2);
  }
  .note h1 {
    margin: 0 0 var(--space-200);
  }
  .summary {
    max-width: 680px;
    margin: 0 0 var(--space-300);
    color: var(--muted);
  }
  .content {
    padding-top: var(--space-200);
    border-top: 1px solid var(--border);
  }
  .crumb {
    display: inline-block;
    color: var(--muted-2);
    text-decoration: none;
    transition:
      color var(--dur-color) var(--ease-out),
      transform var(--dur-color) var(--ease-out);
  }
  .crumb:hover {
    color: var(--accent-text);
  }
  .crumb:active {
    transform: scale(0.98);
  }
  .related {
    margin-top: var(--space-500);
    padding-top: var(--space-300);
    border-top: 1px solid var(--border);
  }
  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-100);
  }
  .related-list li a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-100);
    text-decoration: none;
    transition: transform var(--dur-color) var(--ease-out);
  }
  .related-list li a:active {
    transform: scale(0.98);
  }
  .related-list li a:hover .rel-title {
    color: var(--accent-text);
  }
  .rel-date {
    flex: none;
    color: var(--muted-2);
  }
  .rel-title {
    min-width: 0;
    transition: color var(--dur-color) var(--ease-out);
  }
  .arrow {
    margin-left: auto;
    color: var(--muted-2);
  }
  @media (max-width: 720px) {
    .note h1 {
      font-size: var(--text-4xl);
      line-height: 40px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .crumb,
    .rel-title,
    .related-list li a {
      transition: none;
    }
    .crumb:active,
    .related-list li a:active {
      transform: none;
    }
  }
</style>