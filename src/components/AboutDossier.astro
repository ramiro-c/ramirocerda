---
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: "es" | "en";
  yearsExp: number;
  copy: {
    bio: string;
    personal: string[];
    roles: string[];
    education: string;
    skills: { label: string; items: string }[];
  };
}
const { lang, yearsExp, copy } = Astro.props;
const t = useTranslations(lang);
const labels = {
  personalLabel: t("about.personalLabel"),
  photoCaption: t("about.photoCaption"),
  photoAlt: t("about.photoAlt"),
  rolesLabel: t("about.rolesLabel"),
  educationLabel: t("about.educationLabel"),
  skillsLabel: t("about.skillsLabel"),
  experience: t("about.experience"),
};
---

<div class="dossier">
  <div class="d-main">
    <p class="years body-6">
      <span class="years-num mono body-4">{yearsExp}+</span>
      {labels.experience}
    </p>
    <p class="bio body-3">{copy.bio}</p>

    <div class="personal">
      <div class="personal-copy">
        <p class="section-label caption-3">{labels.personalLabel}</p>
        {copy.personal.map((paragraph) => <p class="personal-p body-3">{paragraph}</p>)}
      </div>

      <figure class="personal-photo">
        <picture>
          <source
            type="image/webp"
            srcset="/nerdearla-midudev-400.webp 400w, /nerdearla-midudev-720.webp 720w"
            sizes="(min-width: 1150px) 22rem, 24rem"
          />
          <img
            class="personal-photo-img"
            src="/nerdearla-midudev-720.jpg"
            width="720"
            height="960"
            alt={labels.photoAlt}
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="personal-photo-caption caption-5">{labels.photoCaption}</figcaption>
      </figure>
    </div>

    <p class="section-label caption-3">{labels.rolesLabel}</p>
    <ul class="d-rows">
      {
        copy.roles.map((role, i) => (
          <li>
            <span class="row-head">
              <span class="num mono caption-4">{String(i + 1).padStart(2, "0")}</span>
              <span class="role body-1">{role}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <section class="d-skills">
    <p class="section-label caption-3">{labels.skillsLabel}</p>
    <ul class="skill-idx">
      {
        copy.skills.map((group, i) => (
          <li>
            <span class="idx-head">
              <span class="num mono caption-4">{String(i + 1).padStart(2, "0")}</span>
              <span class="skill-label body-4">{group.label}</span>
            </span>
            <span class="skill-items body-6">{group.items}</span>
          </li>
        ))
      }
      <li>
        <span class="idx-head">
          <span class="num mono caption-4">{String(copy.skills.length + 1).padStart(2, "0")}</span>
          <span class="skill-label body-4">{labels.educationLabel}</span>
        </span>
        <span class="skill-items body-6">{copy.education}</span>
      </li>
    </ul>
  </section>
</div>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  /* One column. The skills index used to sit in a rail beside the bio, which
     gave a reference list the same weight as the text. It belongs at the end,
     after the trajectory, where a reader who wants it goes looking. */
  .dossier {
    display: block;
  }
  .years {
    margin: 0 0 var(--space-200);
    color: var(--muted-2);
  }
  .years-num {
    margin-right: var(--space-50);
    color: var(--accent-text);
  }
  .bio {
    max-width: 44rem;
    margin: 0 0 var(--space-400);
    color: var(--muted);
  }
  .section-label {
    margin: 0 0 var(--space-100);
    color: var(--muted-2);
  }
  .personal-p {
    max-width: 44rem;
    margin: 0 0 var(--space-200);
    color: var(--muted);
  }
  /* The photo sits in its own column beside the personal paragraphs. The column
     is sized by the copy, not by the picture's own height, so the two always
     close on the same line however much text there is. */
  .personal {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-400);
    margin-top: var(--space-400);
    margin-bottom: var(--space-700);
  }
  .personal-copy > :last-child {
    margin-bottom: 0;
  }
  .personal-photo {
    margin: 0;
  }
  .personal-photo picture {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background-color: var(--surface);
  }
  .personal-photo-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
  .personal-photo-caption {
    margin: var(--space-100) 0 0;
    color: var(--muted-2);
  }
  @media (max-width: 1149px) {
    /* Stacked, the photo is the only image on the page, so it takes the full
       measure and centres instead of sitting small in the left corner. */
    .personal-photo {
      max-width: 24rem;
      margin-inline: auto;
    }
    .personal-photo-caption {
      text-align: center;
    }
  }
  @media (min-width: 1150px) {
    .personal {
      grid-template-columns: minmax(0, 1fr) 22rem;
      column-gap: var(--space-600);
      align-items: stretch;
    }
    /* The picture is taken out of flow so its own height never sets the row. It
       fills whatever height the copy beside it ends up with, which is what keeps
       the image and the text on the same baseline at the bottom. */
    .personal-photo {
      display: grid;
      grid-template-rows: minmax(0, 1fr) auto;
      min-height: 0;
    }
    .personal-photo picture {
      min-height: 0;
    }
    .personal-photo-img {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto;
      /* Keep the faces in frame when the crop turns shorter than the original. */
      object-position: center 32%;
    }
    .personal-photo-caption {
      text-align: left;
    }
  }
  .d-rows {
    list-style: none;
    padding: 0;
    margin: 0;
    /* Same measure as the skills index below it, so the two lists close on the
       same vertical line instead of ending at different widths. */
    max-width: 52rem;
  }
  .d-rows li {
    display: flex;
    align-items: baseline;
    border-top: 1px solid var(--border);
    padding: var(--space-200) 0;
  }
  .d-rows li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .row-head {
    display: flex;
    gap: var(--space-200);
    align-items: baseline;
  }
  .num {
    color: var(--accent-text);
  }
  .role {
    transition: color var(--dur-color) var(--ease-out);
  }
  .d-rows li:hover .role {
    color: var(--accent-text);
  }
  .d-skills {
    margin-top: var(--space-700);
  }
  .skill-idx {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-100);
    /* A capped measure, same as the running text. The technology lists are long
       and at the full shell width they would run as one line you have to track
       across the page. */
    max-width: 52rem;
  }
  .skill-idx li {
    display: grid;
    gap: var(--space-50);
    border-top: 1px solid var(--border);
    padding-top: var(--space-100);
  }
  .skill-idx li:last-child {
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-200);
  }
  .idx-head {
    display: flex;
    gap: var(--space-75);
    align-items: baseline;
  }
  .skill-items {
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .role {
      transition: none;
    }
  }
</style>
