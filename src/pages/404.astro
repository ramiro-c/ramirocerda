---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { useTranslations } from "../i18n/utils";

/**
 * A 404 is one static file. The host serves it for every missing path, so there
 * is no request path to read at build time: the previous version derived the
 * language from Astro.url.pathname, which is always "/404" here, and every
 * visitor silently got Spanish. Rendering both languages is the only way to
 * serve an English reader without relying on JavaScript.
 */
const lang = "es";
const t = useTranslations(lang);
const tEn = useTranslations("en");
---

<BaseLayout lang={lang} title={t("notfound.title")} description={t("notfound.support")}>
  <SiteHeader slot="header" lang={lang} />

  <section class="hero">
    <p class="brand-line mono caption-3">404</p>
    <h1 class="heading-1">{t("notfound.title")}</h1>
    <p class="support body-3">{t("notfound.support")}</p>
    <div class="ctas">
      <a class="cta-primary" href="/">
        {t("notfound.cta")}
      </a>
    </div>

    <div class="en-fallback" lang="en">
      <p class="en-title title-1">{tEn("notfound.title")}</p>
      <p class="en-support body-6">{tEn("notfound.support")}</p>
      <a class="cta-link" href="/en/">
        {tEn("notfound.cta")}
      </a>
    </div>
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  .hero {
    padding: var(--space-200) 0 var(--space-600);
  }
  .brand-line {
    margin: 0 0 var(--space-100);
    color: var(--muted-2);
  }
  .hero h1 {
    margin: 0 0 var(--space-200);
  }
  .support {
    max-width: 680px;
    margin: 0 0 var(--space-300);
    color: var(--muted);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-100);
  }
  /* The English block sits below the Spanish one and steps down in weight, so a
     Spanish reader never has to read past it and an English reader finds the
     whole message in one place. */
  .en-fallback {
    max-width: 680px;
    margin-top: var(--space-600);
    padding-top: var(--space-300);
    border-top: 1px solid var(--border);
  }
  .en-title {
    margin: 0 0 var(--space-50);
  }
  .en-support {
    margin: 0 0 var(--space-200);
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .hero h1 {
      font-size: var(--text-4xl);
      line-height: 40px;
    }
  }
</style>
