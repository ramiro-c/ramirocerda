---
import { useTranslations } from "../i18n/utils";

interface Props {
  lang: "es" | "en";
  yearsExp: number;
  copy: {
    bio: string;
    personal: string[];
    roles: string[];
    education: string;
    skills: { label: string; items: string }[];
  };
}
const { lang, yearsExp, copy } = Astro.props;
const t = useTranslations(lang);
const labels = {
  personalLabel: t("about.personalLabel"),
  photoCaption: t("about.photoCaption"),
  photoAlt: t("about.photoAlt"),
  rolesLabel: t("about.rolesLabel"),
  educationLabel: t("about.educationLabel"),
  skillsLabel: t("about.skillsLabel"),
  experience: t("about.experience"),
};
---

<div class="dossier">
  <div class="d-main">
    <p class="years body-6">
      <span class="years-num mono body-4">{yearsExp}+</span>
      {labels.experience}
    </p>
    <p class="bio body-3">{copy.bio}</p>

    <div class="personal">
      <div class="personal-copy">
        <p class="section-label caption-3">{labels.personalLabel}</p>
        {copy.personal.map((paragraph) => <p class="personal-p body-3">{paragraph}</p>)}
      </div>

      <figure class="personal-photo">
        <picture>
          <source
            type="image/webp"
            srcset="/nerdearla-midudev-400.webp 400w, /nerdearla-midudev-720.webp 720w"
            sizes="(min-width: 720px) 13rem, 22rem"
          />
          <img
            class="personal-photo-img"
            src="/nerdearla-midudev-720.jpg"
            width="720"
            height="960"
            alt={labels.photoAlt}
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="personal-photo-caption caption-5">{labels.photoCaption}</figcaption>
      </figure>
    </div>

    <p class="section-label caption-3">{labels.rolesLabel}</p>
    <ul class="d-rows">
      {
        copy.roles.map((role, i) => (
          <li>
            <span class="row-head">
              <span class="num mono caption-4">{String(i + 1).padStart(2, "0")}</span>
              <span class="role body-1">{role}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <aside class="d-rail">
    <p class="section-label caption-3">{labels.skillsLabel}</p>
    <ul class="skill-idx">
      {
        copy.skills.map((group, i) => (
          <li>
            <span class="idx-head">
              <span class="num mono caption-4">{String(i + 1).padStart(2, "0")}</span>
              <span class="skill-label body-4">{group.label}</span>
            </span>
            <span class="skill-items body-6">{group.items}</span>
          </li>
        ))
      }
      <li>
        <span class="idx-head">
          <span class="num mono caption-4">{String(copy.skills.length + 1).padStart(2, "0")}</span>
          <span class="skill-label body-4">{labels.educationLabel}</span>
        </span>
        <span class="skill-items body-6">{copy.education}</span>
      </li>
    </ul>
  </aside>
</div>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  .dossier {
    display: grid;
    gap: var(--space-300);
  }
  .years {
    margin: 0 0 var(--space-200);
    color: var(--muted-2);
  }
  .years-num {
    margin-right: var(--space-50);
    color: var(--accent-text);
  }
  .bio {
    max-width: 44rem;
    margin: 0 0 var(--space-400);
    color: var(--muted);
  }
  .section-label {
    margin: 0 0 var(--space-100);
    color: var(--muted-2);
  }
  .personal-p {
    max-width: 44rem;
    margin: 0 0 var(--space-200);
    color: var(--muted);
  }
  /* The photo sits beside the personal paragraphs, not under them, so the reader
     sees the person while reading about him. It drops under the copy on narrow
     screens, where two columns would leave the paragraphs too thin to read. */
  .personal {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    gap: var(--space-400);
    align-items: start;
    margin-top: var(--space-400);
  }
  .personal-copy > :last-child {
    margin-bottom: 0;
  }
  .personal-photo {
    margin: 0;
  }
  .personal-photo picture {
    display: block;
  }
  .personal-photo-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-xl);
    background-color: var(--surface);
  }
  .personal-photo-caption {
    margin: var(--space-100) 0 0;
    color: var(--muted-2);
  }
  @media (max-width: 719px) {
    .personal {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-300);
    }
    /* On a phone the photo is the only image on the page, so it takes the full
       measure and centres instead of sitting small in the left corner. */
    .personal-photo {
      max-width: 22rem;
      margin-inline: auto;
    }
    .personal-photo-caption {
      text-align: center;
    }
  }
  .d-rows {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .d-rows li {
    display: flex;
    align-items: baseline;
    border-top: 1px solid var(--border);
    padding: var(--space-200) 0;
  }
  .d-rows li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .row-head {
    display: flex;
    gap: var(--space-200);
    align-items: baseline;
  }
  .num {
    color: var(--accent-text);
  }
  .role {
    transition: color var(--dur-color) var(--ease-out);
  }
  .d-rows li:hover .role {
    color: var(--accent-text);
  }
  .skill-idx {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-100);
  }
  .skill-idx li {
    display: grid;
    gap: var(--space-50);
    border-top: 1px solid var(--border);
    padding-top: var(--space-100);
  }
  .skill-idx li:last-child {
    border-bottom: 1px solid var(--border);
    padding-bottom: var(--space-200);
  }
  .idx-head {
    display: flex;
    gap: var(--space-75);
    align-items: baseline;
  }
  .skill-items {
    color: var(--muted);
  }
  @media (min-width: 860px) {
    .dossier {
      grid-template-columns: 1.7fr 1fr;
      gap: var(--space-500);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .role {
      transition: none;
    }
  }
</style>
