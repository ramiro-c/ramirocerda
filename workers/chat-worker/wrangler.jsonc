{
  "name": "ramirocerda-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-23",
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "botardo-kb"
    }
  ],
  "analytics_engine": [
    {
      "binding": "ANALYTICS"
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      // Unique namespace on the Cloudflare account; must exist before deploy.
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "RAG_ENABLED": "true",
    "TOP_K": "5",
    "SIMILARITY_THRESHOLD": "0.30",
    "GENERATION_MODEL": "deepseek-v4.1-flash",
    "OPENCODE_GO_ENDPOINT": "https://opencode.ai/zen/go/v1/chat/completions",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "SITE_ORIGIN": "https://ramirocerda.com.ar",
    // Adaptive RAG (src/pipeline.ts): LLM router + sufficiency judge via OpenRouter.
    // The API key is a SECRET (wrangler secret put OPENROUTER_API_KEY), never a var.
    // OPENROUTER_MODEL is intentionally empty: set the OpenRouter model slug Ramiro picks.
    // While the model or the key is missing, the worker runs the linear pipeline
    // (search the raw message, similarity gate, generate) and offerContact is false.
    "OPENROUTER_MODEL": "",
    // Per-call timeout for the router and the judge (ms).
    "OPENROUTER_TIMEOUT_MS": "2500",
    // Output budget per control call. Raise it if the model reasons before answering.
    "OPENROUTER_MAX_TOKENS": "256",
    // json_schema (strict schema) | json_object | none (prompt-only JSON). Use the
    // strongest mode the chosen model supports on OpenRouter.
    "OPENROUTER_RESPONSE_FORMAT": "json_schema",
    // Optional reasoning effort for reasoning models (none|minimal|low|medium|high); empty sends nothing.
    "OPENROUTER_REASONING_EFFORT": "",
    // Searches per message, clamped to 1..2 in code. "1" disables the judge and the re-search.
    "MAX_RETRIEVAL_ITERATIONS": "2"
  },
  "observability": {
    "enabled": true
  }
}
