---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WorkflowSplit from "../components/WorkflowSplit.astro";
import { useTranslations } from "../i18n/utils";

const lang = "es";
const t = useTranslations(lang);

const nodes = [
  {
    id: "triage",
    number: "01",
    label: "Triage",
    panelTitle: "Triage inicial",
    panelBody:
      "Se toma una card del backlog en To Do con label agent:loop. Todavía lo disparo yo (no hay cron): cada tick agarra como máximo una card. Clasifica tipo de tarea y asigna prioridad.",
    isHitl: false,
  },
  {
    id: "card-start",
    number: "02",
    label: "card-start",
    panelTitle: "card-start",
    panelBody:
      "Crea un worktree aislado con su propia rama a partir de la card de Jira. Resuelve el repo y la rama base desde los labels de la card. Listo para trabajar sin tocar el checkout principal.",
    isHitl: false,
  },
  {
    id: "sdd-auto",
    number: "03",
    label: "SDD auto",
    panelTitle: "SDD auto",
    panelBody:
      "Pipeline completo de 5 fases: Explore (contexto), Propose (intención), Spec (requisitos + escenarios), Design (arquitectura técnica), Tasks (desglose en tareas). Todo generado por agentes antes de tocar código.",
    isHitl: true,
  },
  {
    id: "card-review",
    number: "04",
    label: "card-review",
    panelTitle: "card-review",
    panelBody:
      "Revisión pre-PR usando los cuatro lentes 4R (Requirements, Reliability, Readability, Risk). Report-only: encuentra issues antes de abrir el PR. Opcionalmente simplifica código si el usuario lo pide.",
    isHitl: false,
  },
  {
    id: "card-pr",
    number: "05",
    label: "card-pr",
    panelTitle: "card-pr",
    panelBody:
      "Push de la rama y apertura del PR en GitHub. No mergea: deja el diff listo para la revisión adversarial del paso siguiente.",
    isHitl: false,
  },
  {
    id: "judgment-day",
    number: "06",
    label: "Judgment Day",
    panelTitle: "Judgment Day",
    panelBody:
      "Revisión adversarial ciega: dos agentes revisan el diff de forma independiente, comparan hallazgos y emiten un veredicto. Si encuentra issues, vuelve a SDD para fix + re-judgment (máximo 2 rondas).",
    isHitl: true,
  },
  {
    id: "partners-slack",
    number: "07",
    label: "Partners / Slack",
    panelTitle: "Partners / Slack",
    panelBody:
      "La card se mueve a Partners/Code Review en Jira y se manda una sola notificación al canal de Slack (backend o frontend). El merge es humano — el loop nunca auto-mergea.",
    isHitl: false,
  },
] as const;

const thesis =
  "Así itero con agentes de IA en Libro de pases: cada card pasa por siete etapas conectadas. El loop alterna entre fases autónomas y puntos de decisión humana.";
const cta = "¿Querés verlo en acción en un proyecto real?";
const ctaLink = "Mirá los proyectos";
const panelHint = "Elegí una etapa para ver el detalle";
---

<BaseLayout lang={lang} title={t("workflow.title")} description={thesis}>
  <SiteHeader slot="header" lang={lang} />

  <section class="workflow">
    <p class="eyebrow caption-3">{t("workflow.eyebrow")}</p>
    <h1 class="heading-1">{t("workflow.title")}</h1>
    <p class="thesis body-3">{thesis}</p>

    <WorkflowSplit nodes={nodes} hitlLabel={t("workflow.legend.hitl")} panelHint={panelHint} />

    <section class="how-terminates">
      <h2 class="section-label caption-3">{t("workflow.howTerminatesLabel")}</h2>
      <p class="terminates-text body-6">{t("workflow.howTerminates")}</p>
    </section>

    <div class="cta-block">
      <p class="cta-text body-6">{cta}</p>
      <a class="cta-primary" href="/work/">
        {ctaLink}
      </a>
    </div>
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  .workflow {
    padding: var(--space-200) 0 var(--space-600);
  }
  .eyebrow {
    margin: 0 0 var(--space-75);
    color: var(--muted-2);
  }
  .workflow h1 {
    margin: 0 0 var(--space-200);
  }
  .thesis {
    max-width: 680px;
    margin: 0 0 var(--space-200);
    color: var(--muted);
  }
  .section-label {
    margin: 0 0 var(--space-75);
    color: var(--muted-2);
  }
  .how-terminates {
    margin: var(--space-300) 0;
    padding-top: var(--space-200);
    border-top: 1px solid var(--border);
  }
  .terminates-text {
    max-width: 680px;
    margin: 0;
    color: var(--muted);
  }
  .cta-block {
    display: grid;
    justify-items: start;
    gap: var(--space-100);
    margin: var(--space-400) 0 0;
    padding: var(--space-300);
    border: 1px solid var(--border);
    border-radius: var(--radius-2xl);
    background: var(--surface);
  }
  .cta-text {
    margin: 0;
    color: var(--muted);
  }
  @media (max-width: 720px) {
    .workflow h1 {
      font-size: var(--text-4xl);
      line-height: 40px;
    }
  }
</style>
