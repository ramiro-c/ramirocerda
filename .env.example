# Root .env (copy to .env, which is gitignored). Names only: never commit real values.
# Astro loads it for the site; the Node scripts (chat:populate, chat:stats,
# chat:eval, site:stats) load it with process.loadEnvFile.

# --- Site (astro dev / build) ---
# OPTIONAL. Botardo worker base URL. Unset: the deployed worker.
# Local worker: http://localhost:8787
# PUBLIC_BOTARDO_WORKER_URL=

# --- Cloudflare (scripts only, never needed by the site) ---
# REQUIRED for chat:populate, chat:stats and chat:eval (real mode).
CLOUDFLARE_ACCOUNT_ID=
# REQUIRED for the same scripts. chat:eval needs Workers AI + Vectorize read;
# chat:populate needs Vectorize write.
CLOUDFLARE_API_TOKEN=
# OPTIONAL. Least-privilege token (Account Analytics Read) for chat:stats;
# takes precedence over CLOUDFLARE_API_TOKEN when set.
# CLOUDFLARE_ANALYTICS_TOKEN=

# --- Vercel (site:stats only) ---
# OPTIONAL. Required only by `pnpm site:stats`.
# VERCEL_TOKEN=

# --- Overrides (optional, have defaults) ---
# Vectorize index for chat:populate / chat:eval (default botardo-kb).
# VECTORIZE_INDEX=
# Faithfulness judge model for chat:eval (default GENERATION_MODEL).
# EVAL_JUDGE_MODEL=
