---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AboutDossier from "../components/AboutDossier.astro";
import { useTranslations } from "../i18n/utils";

const lang = "es";
const t = useTranslations(lang);
const yearsExp = new Date().getFullYear() - 2020;

const copy = {
  es: {
    bio: `AI Systems Engineer — high ownership, high agency: hago lo que haya que hacer, sea devops, frontend, backend o mobile. Tech Lead hands-on en LDP (Libro de Pases): auditorías de arquitectura, performance y mentoría. Sostengo el ciclo completo de un agente de IA: evals deterministas sin juez LLM, grounding con permisos por usuario y deploy. Ingeniero en Sistemas de Información (UTN, 2023).`,
    personal: [
      "Soy curioso y bastante tranquilo. Leo mucha ciencia ficción y distopía — Orwell, Huxley, Asimov, Philip K. Dick — y me engancha la estética cyberpunk, tipo Ghost in the Shell. También leí bastante estoicismo; Meditaciones de Marco Aurelio me marcó.",
      "Entreno, voy al gym y me gustan las artes marciales. Cuando puedo, trekking y viajar. Me interesan las plantas y los insectos: detalles chicos del mundo que me entretienen.",
    ],
    roles: [
      "LDP — RN Dev → React Dev → Tech Lead Full-Stack · 4 años",
      "DevGAM — Full-stack freelance: sistemas de gestión multi-rubro (PHP, JS, MySQL)",
      "UTN FRLP / Secretaría de TIC — Full-stack: trámites administrativos (Laravel, Vue)",
      "New Logic — React freelance: blog con marketplace sobre GCP",
    ],
    education: "UTN — Ingeniería en Sistemas de Información (2023) · Coderhouse — AI Engineering (2026)",
    skills: [
      {
        label: "Frontend & Mobile",
        items:
          "React 19, React Native, TypeScript, Expo, Zustand, React Query, Vue.js, Tailwind CSS v4, Shadcn/ui",
      },
      {
        label: "Backend, Cloud & Data",
        items:
          "Node.js, NestJS, Python, FastAPI, MySQL, PostgreSQL, GCP (Vertex AI, Cloud Run), Cloudflare Workers, APIs REST",
      },
      {
        label: "IA & Automatización",
        items:
          "Google ADK, LangGraph, Workers AI, Gemini, Anthropic, n8n, OpenRouter, Cursor / Claude Code",
      },
      {
        label: "DevOps, Calidad & Testing",
        items:
          "CI/CD, Docker, Git, Sentry, New Relic, Pytest, Jest, Vitest, Playwright, SonarQube",
      },
      {
        label: "Procesos",
        items: "SCRUM, GitFlow, code reviews, Jira, Confluence",
      },
    ],
  },
} as const;

const about = copy[lang];
---

<BaseLayout lang={lang} title={t("about.title")} description={about.bio}>
  <SiteHeader slot="header" lang={lang} />

  <section class="about">
    <h1 class="display">{t("about.title")}</h1>
    <AboutDossier lang={lang} yearsExp={yearsExp} copy={about} />
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  .about {
    padding: 1rem 0 2rem;
  }
  .display {
    margin: 0 0 0.75rem;
    font-size: clamp(2.2rem, 7vw, 3.6rem);
    line-height: 0.95;
  }
</style>
