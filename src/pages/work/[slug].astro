---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getLocalizedPath, useTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
  const [projects, allNotes] = await Promise.all([getCollection("projects"), getCollection("notes")]);
  return projects.map((project) => {
    const relatedNotes = allNotes
      .filter(
        (n) =>
          n.data.lang === "es" &&
          !n.data.draft &&
          (n.data.relatedProjects || []).includes(project.data.slug),
      )
      .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
      .map((n) => ({
        slug: n.data.slug || n.id.replace(/^(es|en)\//, ""),
        title: n.data.title,
        dateStr: n.data.pubDate.toLocaleDateString("es-AR", { day: "2-digit", month: "short", year: "numeric" }),
      }));
    return {
      params: { slug: project.data.slug },
      props: { project, relatedNotes },
    };
  });
}

const lang = "es";
const t = useTranslations(lang);
const { project, relatedNotes } = Astro.props as {
  project: Awaited<ReturnType<typeof getCollection>>[number];
  relatedNotes: Array<{ slug: string; title: string; dateStr: string }>;
};
const data = project.data[lang];
const backPath = "/work/";

const links = [
  project.data.repo ? { href: project.data.repo, label: "Repo" } : null,
  project.data.demo ? { href: project.data.demo, label: "Demo" } : null,
].filter(Boolean) as Array<{ href: string; label: string }>;
---

<BaseLayout lang={lang} title={data.title} description={data.summary}>
  <SiteHeader slot="header" lang={lang} />

  <article class="case-study">
    <p class="mono label"><a class="crumb" href={getLocalizedPath(lang, backPath)}>{t("work.back")}</a> / {project.data.slug}</p>
    <h1 class="display heading">{data.title}</h1>

    <p class="mono meta">
      <span class="kind">{t(`kind.${project.data.kind}`)}</span>
      {project.data.status && <span class="dot" aria-hidden="true">·</span>}
      {project.data.status && <span class="status">{t(`status.${project.data.status}`)}</span>}
      {project.data.year && <span class="dot" aria-hidden="true">·</span>}
      {project.data.year && <span class="year">{project.data.year}</span>}
    </p>

    <p class="summary">{data.summary}</p>

    <section class="section">
      <p class="mono section-label">{t("project.problem")}</p>
      <p class="body">{data.problem}</p>
    </section>

    <section class="section">
      <p class="mono section-label">{t("project.what")}</p>
      <p class="body">{data.what}</p>
    </section>

    {data.highlights.length > 0 && (
      <section class="section">
        <p class="mono section-label">{t("project.highlights")}</p>
        <ul class="highlights">
          {data.highlights.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>
    )}

    <section class="section">
      <p class="mono section-label">{t("project.stack")}</p>
      <ul class="stack">
        {data.stack.map((item) => (
          <li class="mono">{item}</li>
        ))}
      </ul>
    </section>

    <section class="section">
      <p class="mono section-label">{t("project.links")}</p>
      {links.length > 0 ? (
        <ul class="links">
          {links.map((link) => (
            <li>
              <a href={link.href} rel="noreferrer" target="_blank">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="body muted">—</p>
      )}
    </section>

    {relatedNotes.length > 0 && (
      <section class="section related">
        <p class="mono section-label">{t("project.relatedNotes")}</p>
        <ul class="related-list">
          {relatedNotes.map((n) => (
            <li>
              <a href={getLocalizedPath(lang, `/notes/${n.slug}/`)}>
                <span class="rel-date mono">{n.dateStr}</span>
                <span class="rel-title">{n.title}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  .case-study {
    padding: 1rem 0 2rem;
  }
  .label,
  .section-label {
    margin: 0 0 0.75rem;
    color: var(--muted-2);
    font-size: 0.8rem;
  }
  .heading {
    margin: 0 0 0.75rem;
    font-size: clamp(2.2rem, 7vw, 3.8rem);
    line-height: 0.95;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 1.5rem;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .meta .status {
    color: var(--accent);
  }
  .summary {
    max-width: 44rem;
    margin: 0 0 2rem;
    padding-left: 0.9rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
  }
  .section {
    padding: 1rem 0 0;
    border-top: 1px solid var(--border);
    margin-top: 1rem;
  }
  .body {
    margin: 0;
    max-width: 44rem;
  }
  .muted {
    color: var(--muted-2);
  }
  .highlights {
    margin: 0;
    max-width: 44rem;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.5rem;
  }
  .highlights li {
    line-height: 1.5;
  }
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .stack li {
    font-size: 0.8rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
  }
  .links {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }
  .links a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .crumb {
    color: var(--muted-2);
    text-decoration: none;
  }
  .crumb:hover {
    color: var(--accent);
  }
  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .related-list li a {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    text-decoration: none;
  }
  .related-list li a:hover .rel-title {
    color: var(--accent);
  }
  .rel-date {
    flex: none;
    font-size: 0.68rem;
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .rel-title {
    font-weight: 700;
  }
  .arrow {
    margin-left: auto;
    color: var(--muted-2);
  }
</style>