---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import AboutDossier from "../../components/AboutDossier.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "en";
const t = useTranslations(lang);
const yearsExp = new Date().getFullYear() - 2020;

const copy = {
  en: {
    bio: `Full-Stack Engineer — high ownership, high agency: I do whatever it takes, whether devops, frontend, backend, or mobile. Hands-on Tech Lead at LDP (Libro de Pases): architecture audits, performance, and mentoring. Systems Engineering (UTN, 2023).`,
    personal: [
      "I'm curious and fairly quiet. I read a lot of science fiction and dystopia — Orwell, Huxley, Asimov, Philip K. Dick — and I'm drawn to cyberpunk aesthetics, Ghost in the Shell style. I've also read a fair bit of Stoicism; Marcus Aurelius' Meditations left a mark.",
      "I train, go to the gym, and like martial arts. When I can, trekking and travel. Plants and insects interest me too — small details of the world that keep me company.",
    ],
    roles: [
      "LDP — RN Dev → React Dev → Tech Lead Full-Stack · 4 years",
      "DevGAM — Full-stack freelance: multi-industry management systems (PHP, JS, MySQL)",
      "UTN FRLP / ICT Secretariat — Full-stack: administrative workflows (Laravel, Vue)",
      "New Logic — React freelance: blog with marketplace on GCP",
    ],
    education: "UTN — Systems Information Engineering (2023) · Coderhouse — AI Engineering (2026)",
    skills: [
      {
        label: "Frontend & Mobile",
        items:
          "React 19, React Native, TypeScript, Expo, Zustand, React Query, Vue.js, Tailwind CSS v4, Shadcn/ui",
      },
      {
        label: "Backend, Cloud & Data",
        items:
          "Node.js, NestJS, Python, FastAPI, MySQL, PostgreSQL, GCP (Vertex AI, Cloud Run), Cloudflare Workers, REST APIs",
      },
      {
        label: "AI & Automation",
        items:
          "Google ADK, LangGraph, Workers AI, Gemini, Anthropic, n8n, OpenRouter, Cursor / Claude Code",
      },
      {
        label: "DevOps, Quality & Testing",
        items:
          "CI/CD, Docker, Git, Sentry, New Relic, Pytest, Jest, Vitest, Playwright, SonarQube",
      },
      {
        label: "Process",
        items: "SCRUM, GitFlow, code reviews, Jira, Confluence",
      },
    ],
  },
} as const;

const about = copy[lang];
---

<BaseLayout lang={lang} title={t("about.title")} description={about.bio}>
  <SiteHeader slot="header" lang={lang} />

  <section class="about">
    <h1 class="display">{t("about.title")}</h1>
    <AboutDossier lang={lang} yearsExp={yearsExp} copy={about} />
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  .about {
    padding: 1rem 0 2rem;
  }
  .display {
    margin: 0 0 0.75rem;
    font-size: clamp(2.2rem, 7vw, 3.6rem);
    line-height: 0.95;
  }
</style>
