---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { useTranslations } from "../../i18n/utils";

const lang = "es";
const t = useTranslations(lang);
const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((project) => ({
    slug: project.data.slug,
    title: project.data[lang].title,
    summary: project.data[lang].summary,
    kind: project.data.kind,
    status: project.data.status,
    year: project.data.year,
    tags: project.data.tags,
    track: project.data.track,
  }));

const trackIds = ["ai-systems", "product"] as const;
const groups = trackIds
  .map((id) => ({
    id,
    title: t(id === "ai-systems" ? "work.trackAiTitle" : "work.trackProductTitle"),
    note: t(id === "ai-systems" ? "work.trackAiNote" : "work.trackProductNote"),
    items: projects.filter((project) => project.track === id),
  }))
  .filter((group) => group.items.length > 0);
---

<BaseLayout lang={lang} title={t("work.title")} description={t("work.description")}>
  <SiteHeader slot="header" lang={lang} />

  <section class="work">
    <p class="label caption-3">01 / {t("work.title")}</p>
    <h1 class="heading-1">{t("work.title")}</h1>

    {
      groups.map((group) => (
        <section class="track">
          <div class="track-head">
            <h2 class="track-title caption-3">{group.title}</h2>
            <p class="track-note caption-5">{group.note}</p>
          </div>
          <ul class="cat">
            {group.items.map((item, i) => (
              <li>
                <a href={`/work/${item.slug}/`}>
                  <span class="row-head">
                    <span class="num mono caption-4">{String(i + 1).padStart(2, "0")}</span>
                    <span class="meta mono caption-5">
                      {item.status && <span class="status caption-3">{t(`status.${item.status}`)}</span>}
                      {item.status && item.kind && <span class="dot">·</span>}
                      {item.kind && <span class="kind">{t(`kind.${item.kind}`)}</span>}
                      {(item.status || item.kind) && item.year && <span class="dot">·</span>}
                      {item.year && <span class="year">{item.year}</span>}
                    </span>
                  </span>
                  <span class="title title-1">{item.title}</span>
                  <span class="summary body-6">{item.summary}</span>
                  {item.tags && item.tags.length > 0 && (
                    <span class="tags">
                      {item.tags.map((tag) => (
                        <span class="tag caption-4">{tag}</span>
                      ))}
                    </span>
                  )}
                  <span class="go body-3" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  .work {
    padding: var(--space-200) 0 var(--space-600);
  }
  .label {
    margin: 0 0 var(--space-100);
    color: var(--muted-2);
  }
  .work h1 {
    margin: 0 0 var(--space-300);
  }
  .cat {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .track {
    margin-top: var(--space-400);
  }
  .track-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-75) var(--space-200);
    margin-bottom: var(--space-100);
  }
  .track-title {
    margin: 0;
    color: var(--text);
  }
  .track-note {
    max-width: 52ch;
    margin: 0;
    color: var(--muted);
  }
  .cat li {
    position: relative;
    border-top: 1px solid var(--border);
    padding: var(--space-200) 0 var(--space-300);
  }
  .cat li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .cat a {
    display: grid;
    gap: var(--space-50);
    text-decoration: none;
    color: inherit;
    transition: transform var(--dur-color) var(--ease-out);
  }
  .cat a:active {
    transform: scale(0.98);
  }
  .row-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    /* Reserve the right edge for the absolutely positioned .go arrow, so it
       never lands on top of the status · kind · year meta line. */
    padding-right: var(--space-400);
  }
  .num {
    color: var(--accent-text);
  }
  .meta {
    display: inline-flex;
    flex-wrap: wrap;
    min-width: 0;
    align-items: baseline;
    gap: var(--space-50);
  }
  .status {
    color: var(--accent-text);
  }
  .dot,
  .kind,
  .year {
    color: var(--muted-2);
  }
  .title {
    transition: color var(--dur-color) var(--ease-out);
  }
  .cat a:hover .title {
    color: var(--accent-text);
  }
  .summary {
    max-width: 52ch;
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-50);
  }
  .tag {
    padding: var(--space-25) var(--space-75);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--muted);
  }
  .go {
    position: absolute;
    right: 0;
    top: var(--space-200);
    color: var(--accent);
    opacity: 0;
    transform: translateX(calc(var(--space-75) * -1));
    transition:
      opacity var(--dur-color) var(--ease-out),
      transform var(--dur-move) var(--ease-out);
  }
  .cat a:hover .go,
  .cat a:focus-within .go {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 720px) {
    .work h1 {
      font-size: var(--text-4xl);
      line-height: 40px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .title,
    .go {
      transition: none;
    }
    .go {
      opacity: 1;
      transform: none;
    }
    .cat a:active {
      transform: none;
    }
  }
</style>
