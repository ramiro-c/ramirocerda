---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getLocalizedPath, useTranslations } from "../../i18n/utils";

export async function getStaticPaths() {
  const notes = await getCollection("notes");
  if (!notes.length) return [];

  return Promise.all(
    notes
      .filter((note) => !note.data.draft && note.data.lang === "es")
      .map(async (note) => {
        const otherNotes = notes
          .filter((n) => n.data.lang === "es" && !n.data.draft && n.id !== note.id)
          .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
          .slice(0, 3)
          .map((n) => ({
            slug: n.data.slug || n.id.replace(/^(es|en)\//, ""),
            title: n.data.title,
            dateStr: n.data.pubDate.toLocaleDateString("es-AR", { timeZone: "UTC", day: "2-digit", month: "short", year: "numeric" }),
          }));
        const relatedProjectSlugs = note.data.relatedProjects || [];
        const projects = (await getCollection("projects"))
          .filter((p) => relatedProjectSlugs.includes(p.data.slug))
          .map((p) => ({ slug: p.data.slug, title: p.data.es.title, status: p.data.status }));
        return {
          params: { slug: note.data.slug || note.id.replace(/^(es|en)\//, "") },
          props: { note, otherNotes, projects },
        };
      }),
  );
}

const lang = "es";
const t = useTranslations(lang);
const { note, otherNotes, projects } = Astro.props as {
  note: Awaited<ReturnType<typeof getCollection>>[number];
  otherNotes: Array<{ slug: string; title: string; dateStr: string }>;
  projects: Array<{ slug: string; title: string; status?: string }>;
};
const { Content } = await render(note);
---

<BaseLayout lang={lang} title={note.data.title} description={note.data.description}>
  <SiteHeader slot="header" lang={lang} />

  <article class="note">
    <p class="mono label"><a class="crumb" href={getLocalizedPath(lang, "/notes/")}>{t("notes.back")}</a> / {note.data.lang.toUpperCase()}</p>
    <h1 class="display heading">{note.data.title}</h1>
    <p class="summary">{note.data.description}</p>
    <div class="content">
      <Content />
    </div>

    {projects.length > 0 && (
      <section class="related">
        <p class="mono label">{t("notes.relatedProjects")}</p>
        <ul class="related-list">
          {projects.map((p) => (
            <li>
              <a href={getLocalizedPath(lang, `/work/${p.slug}/`)}>
                <span class="rel-title">{p.title}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {otherNotes.length > 0 && (
      <section class="related">
        <p class="mono label">{t("notes.other")}</p>
        <ul class="related-list">
          {otherNotes.map((n) => (
            <li>
              <a href={getLocalizedPath(lang, `/notes/${n.slug}/`)}>
                <span class="rel-date mono">{n.dateStr}</span>
                <span class="rel-title">{n.title}</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  .note {
    padding: 1rem 0 2rem;
  }
  .label {
    margin: 0 0 0.75rem;
    color: var(--muted-2);
    font-size: 0.8rem;
  }
  .heading {
    margin: 0 0 1rem;
    font-size: clamp(2.2rem, 7vw, 3.6rem);
    line-height: 0.95;
  }
  .summary {
    max-width: 44rem;
    margin: 0 0 1.5rem;
    color: var(--muted);
  }
  .content {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
  }
  .crumb {
    color: var(--muted-2);
    text-decoration: none;
  }
  .crumb:hover {
    color: var(--accent);
  }
  .related {
    margin-top: 2.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }
  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .related-list li a {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    text-decoration: none;
  }
  .related-list li a:hover .rel-title {
    color: var(--accent);
  }
  .rel-date {
    flex: none;
    font-size: 0.68rem;
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .rel-title {
    font-weight: 700;
  }
  .arrow {
    margin-left: auto;
    color: var(--muted-2);
  }
</style>