---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AboutDossier from "../components/AboutDossier.astro";
import { useTranslations } from "../i18n/utils";

const lang = "es";
const t = useTranslations(lang);
const yearsExp = new Date().getFullYear() - 2020;

const copy = {
  es: {
    bio: `Tech lead y desarrollador full stack en Buenos Aires. Lidero el desarrollo en Libro de Pases y llevo agentes de IA a producción. Ingeniero en Sistemas de Información (UTN, 2023).`,
    personal: [
      "Leo mucho. Casi todo ciencia ficción dura, terror y distopías. Prefiero los libros usados: me gusta encontrar las anotaciones de alguien que pasó antes por ahí y el olor a libro viejo. Mis favoritos son 1984, Un mundo feliz, Neuromante y Cementerio de animales.",
      "Hice artes marciales toda mi vida, BJJ, taekwondo, MMA y kickboxing. Ahora estoy full con el gym. Cuando puedo me escapo a la montaña, hago trekking y me quedo mirando los eventos naturales. Los ríos, el sol, la luna, las estrellas, las abejas. También me gusta investigar bichos y ensuciarme entero con mis hijos.",
      "En pantalla, Interstellar es mi favorita, y Yo, Robot y GoT me marcaron. De música soy de rock: Pity Álvarez, Viejas Locas y Molchat Doma, ese post punk bielorruso que escuchaba en loop mientras leía 1984. Creo que por eso ese libro me pegó tanto. También me gusta la clásica, así que el mix no tiene ningún sentido.",
    ],
    roles: [
      "LDP — RN Dev → React Dev → Tech Lead Full stack · 4 años",
      "DevGAM — Full stack freelance: sistemas de gestión multi rubro (PHP, JS, MySQL)",
      "UTN FRLP / Secretaría de TIC — Full stack: trámites administrativos (Laravel, Vue)",
      "New Logic — React freelance: blog con marketplace sobre GCP",
    ],
    education: "UTN — Ingeniería en Sistemas de Información (2023) · Coderhouse — AI Engineering (2026)",
    skills: [
      {
        label: "Frontend & Mobile",
        items:
          "React 19, React Native, TypeScript, Expo, Zustand, React Query, Vue.js, Tailwind CSS v4, Shadcn/ui",
      },
      {
        label: "Backend, Cloud & Data",
        items:
          "Node.js, NestJS, Python, FastAPI, MySQL, PostgreSQL, GCP (Vertex AI, Cloud Run), Cloudflare Workers, APIs REST",
      },
      {
        label: "IA & Automatización",
        items:
          "Google ADK, LangGraph, Workers AI, Gemini, Anthropic, n8n, OpenRouter, Cursor / Claude Code",
      },
      {
        label: "DevOps, Calidad & Testing",
        items:
          "CI/CD, Docker, Git, Sentry, New Relic, Pytest, Jest, Vitest, Playwright, SonarQube",
      },
      {
        label: "Procesos",
        items: "SCRUM, GitFlow, code reviews, Jira, Confluence",
      },
    ],
  },
} as const;

const about = copy[lang];
---

<BaseLayout lang={lang} title={t("about.title")} description={about.bio}>
  <SiteHeader slot="header" lang={lang} />

  <section class="about">
    <h1 class="heading-1">{t("about.title")}</h1>
    <AboutDossier lang={lang} yearsExp={yearsExp} copy={about} />
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  .about {
    padding: var(--space-200) 0 var(--space-600);
  }
  .about h1 {
    margin: 0 0 var(--space-300);
  }
  @media (max-width: 720px) {
    .about h1 {
      font-size: var(--text-4xl);
      line-height: 40px;
    }
  }
</style>
