---
import { languages, type Lang } from "../i18n/ui";
import { switchLangPath } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const path = Astro.url.pathname;
---

<nav class="lang" aria-label="Language">
  {
    (Object.keys(languages) as Lang[]).map((code) => (
      <a
        href={switchLangPath(path, code)}
        aria-current={code === lang ? "page" : undefined}
        class:list={["caption-3", { active: code === lang }]}
      >
        {code}
      </a>
    ))
  }
</nav>

<style>
  .lang {
    display: flex;
    gap: var(--space-25);
  }
  .lang a {
    padding: var(--space-25) var(--space-75);
    border-radius: var(--radius-md);
    color: var(--muted-2);
    text-decoration: none;
    transition:
      color var(--dur-color) var(--ease-out),
      background-color var(--dur-color) var(--ease-out),
      transform var(--dur-color) var(--ease-out);
  }
  .lang a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .lang a:active {
    transform: scale(0.98);
  }
  @media (prefers-reduced-motion: reduce) {
    .lang a:active {
      transform: none;
    }
  }
  .lang a.active,
  .lang a[aria-current="page"] {
    color: var(--text);
    background: var(--surface-2);
  }
</style>
