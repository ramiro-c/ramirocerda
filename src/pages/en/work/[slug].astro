---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { getLocalizedPath, useTranslations } from "../../../i18n/utils";

export async function getStaticPaths() {
  const [projects, allNotes] = await Promise.all([getCollection("projects"), getCollection("notes")]);
  return projects.map((project) => {
    const relatedNotes = allNotes
      .filter(
        (n) => n.data.lang === "en" && !n.data.draft && (n.data.relatedProjects || []).includes(project.data.slug),
      )
      .toSorted((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
      .map((n) => ({
        slug: n.data.slug || n.id.replace(/^(es|en)\//, ""),
        title: n.data.title,
        dateStr: n.data.pubDate.toLocaleDateString("en-US", {
          timeZone: "UTC",
          day: "2-digit",
          month: "short",
          year: "numeric",
        }),
      }));
    return {
      params: { slug: project.data.slug },
      props: { project, relatedNotes },
    };
  });
}

const lang = "en";
const t = useTranslations(lang);
const { project, relatedNotes } = Astro.props as {
  project: Awaited<ReturnType<typeof getCollection>>[number];
  relatedNotes: Array<{ slug: string; title: string; dateStr: string }>;
};
const data = project.data[lang];
const backPath = "/work/";

const links = [
  project.data.repo ? { href: project.data.repo, label: "Repo" } : null,
  project.data.demo ? { href: project.data.demo, label: "Demo" } : null,
].filter(Boolean) as Array<{ href: string; label: string }>;
---

<BaseLayout lang={lang} section="work" title={data.title} description={data.summary}>
  <SiteHeader slot="header" lang={lang} />

  <article class="case-study">
    <p class="label caption-3">
      <a class="crumb" href={getLocalizedPath(lang, backPath)}>
        {t("work.back")}
      </a>{" "}
      / {project.data.slug}
    </p>
    <h1 class="heading-1">{data.title}</h1>

    <p class="meta mono caption-5">
      {project.data.kind && <span class="kind">{t(`kind.${project.data.kind}`)}</span>}
      {project.data.status && project.data.kind && (
        <span class="dot" aria-hidden="true">
          ·
        </span>
      )}
      {project.data.status && <span class="status caption-3">{t(`status.${project.data.status}`)}</span>}
      {(project.data.status || project.data.kind) && project.data.year && (
        <span class="dot" aria-hidden="true">
          ·
        </span>
      )}
      {project.data.year && <span class="year">{project.data.year}</span>}
    </p>

    <p class="summary body-3">{data.summary}</p>

    <section class="section">
      <p class="section-label caption-3">{t("project.problem")}</p>
      <p class="body body-3">{data.problem}</p>
    </section>

    <section class="section">
      <p class="section-label caption-3">{t("project.what")}</p>
      <p class="body body-3">{data.what}</p>
    </section>

    {data.highlights.length > 0 && (
      <section class="section">
        <p class="section-label caption-3">{t("project.highlights")}</p>
        <ul class="highlights">
          {data.highlights.map((item) => (
            <li class="body-3">{item}</li>
          ))}
        </ul>
      </section>
    )}

    <section class="section">
      <p class="section-label caption-3">{t("project.stack")}</p>
      <ul class="stack">
        {data.stack.map((item) => (
          <li class="caption-4">{item}</li>
        ))}
      </ul>
    </section>

    <section class="section">
      <p class="section-label caption-3">{t("project.links")}</p>
      {links.length > 0 ? (
        <ul class="links">
          {links.map((link) => (
            <li>
              <a href={link.href} rel="noreferrer" target="_blank">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="body body-3 muted">—</p>
      )}
    </section>

    {relatedNotes.length > 0 && (
      <section class="section related">
        <p class="section-label caption-3">{t("project.relatedNotes")}</p>
        <ul class="related-list">
          {relatedNotes.map((n) => (
            <li>
              <a href={getLocalizedPath(lang, `/notes/${n.slug}/`)}>
                <span class="rel-date mono caption-4">{n.dateStr}</span>
                <span class="rel-title title-3">{n.title}</span>
                <span class="arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  .case-study {
    padding: var(--space-200) 0 var(--space-600);
  }
  .label,
  .section-label {
    margin: 0 0 var(--space-100);
    color: var(--muted-2);
  }
  .case-study h1 {
    margin: 0 0 var(--space-100);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-50);
    margin: 0 0 var(--space-300);
    color: var(--muted-2);
  }
  .meta .status {
    color: var(--accent-text);
  }
  .summary {
    max-width: 680px;
    margin: 0 0 var(--space-400);
    padding-left: var(--space-100);
    border-left: 1px solid var(--accent);
    color: var(--muted);
  }
  .section {
    margin-top: var(--space-300);
    padding-top: var(--space-200);
    border-top: 1px solid var(--border);
  }
  .body {
    max-width: 680px;
    margin: 0;
  }
  .muted {
    color: var(--muted-2);
  }
  .highlights {
    display: grid;
    gap: var(--space-75);
    max-width: 680px;
    margin: 0;
    padding-left: var(--space-200);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-50);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stack li {
    padding: var(--space-25) var(--space-75);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
  }
  .links {
    display: grid;
    gap: var(--space-50);
    margin: 0;
    padding-left: var(--space-200);
  }
  .links a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    transition: color var(--dur-color) var(--ease-out);
  }
  .links a:hover {
    color: var(--accent-text);
  }
  .crumb {
    display: inline-block;
    color: var(--muted-2);
    text-decoration: none;
    transition:
      color var(--dur-color) var(--ease-out),
      transform var(--dur-color) var(--ease-out);
  }
  .crumb:hover {
    color: var(--accent-text);
  }
  .crumb:active {
    transform: scale(0.98);
  }
  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-100);
  }
  /* Rows are a grid so the date, the title and the arrow share one line no
     matter how long the title is. As flex, the title took its natural width,
     pushed the arrow onto a line of its own and the row lost its rhythm. */
  .related-list li a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--space-100);
    text-decoration: none;
    transition: transform var(--dur-color) var(--ease-out);
  }
  .related-list li a:active {
    transform: scale(0.98);
  }
  .related-list li a:hover .rel-title {
    color: var(--accent-text);
  }
  .rel-date {
    grid-column: 1;
    grid-row: 1;
    color: var(--muted-2);
  }
  .rel-title {
    grid-column: 2;
    grid-row: 1;
    transition: color var(--dur-color) var(--ease-out);
  }
  .arrow {
    grid-column: 3;
    grid-row: 1;
    color: var(--muted-2);
  }
  @media (max-width: 720px) {
    .case-study h1 {
      font-size: var(--text-4xl);
      line-height: 40px;
    }
    /* Stacked: the date sits above the title and the arrow centres against both,
       because three tracks leave the title a few words per line on a phone. */
    .related-list li a {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: var(--space-50);
    }
    .rel-date {
      grid-row: 1;
    }
    .rel-title {
      grid-column: 1;
      grid-row: 2;
    }
    .arrow {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .crumb,
    .links a,
    .rel-title,
    .related-list li a {
      transition: none;
    }
    .crumb:active,
    .related-list li a:active {
      transform: none;
    }
  }
</style>
