---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { languages, type Lang } from "../../i18n/ui";
import { useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const yearsExp = new Date().getFullYear() - 2020;

const copy = {
  es: {
    bio: `Tech Lead Full-Stack en LDP (Libro de Pases). Ingeniero en Sistemas de Información (UTN, 2023), Buenos Aires. Más de ${yearsExp} años construyendo productos digitales end-to-end: ownership de módulos críticos, auditorías de arquitectura, performance y mentoría.`,
    roles: [
      "LDP — RN Dev → React Dev → Tech Lead Full-Stack · 4 años",
      "DevGAM — Full-stack freelance: sistemas de gestión multi-rubro (PHP, JS, MySQL)",
      "UTN FRLP / Secretaría de TIC — Full-stack: trámites administrativos (Laravel, Vue)",
      "New Logic — React freelance: blog con marketplace sobre GCP",
    ],
    education: "UTN — Ingeniería en Sistemas de Información (2023)",
    skills: [
      {
        label: "Frontend & Mobile",
        items:
          "React 19, React Native, TypeScript, Expo, Zustand, React Query, Vue.js, Tailwind CSS v4, Shadcn/ui",
      },
      {
        label: "Backend, Cloud & Data",
        items:
          "Node.js, NestJS, Python, FastAPI, MySQL, PostgreSQL, GCP (Vertex AI, Cloud Run), Cloudflare Workers, APIs REST",
      },
      {
        label: "IA & Automatización",
        items:
          "Google ADK, LangGraph, Workers AI, Gemini, Anthropic, n8n, OpenRouter, Cursor / Claude Code",
      },
      {
        label: "DevOps, Calidad & Testing",
        items:
          "CI/CD, Docker, Git, Sentry, New Relic, Pytest, Jest, Vitest, Playwright, SonarQube",
      },
      {
        label: "Procesos",
        items: "SCRUM, GitFlow, code reviews, Jira, Confluence",
      },
    ],
  },
  en: {
    bio: `Tech Lead Full-Stack at LDP (Libro de Pases). Systems Engineering graduate (UTN, 2023), based in Buenos Aires. Over ${yearsExp} years building digital products end to end: ownership of critical modules, architecture audits, performance work, and mentoring.`,
    roles: [
      "LDP — RN Dev → React Dev → Tech Lead Full-Stack · 4 years",
      "DevGAM — Full-stack freelance: multi-industry management systems (PHP, JS, MySQL)",
      "UTN FRLP / Secretaría de TIC — Full-stack: administrative workflows (Laravel, Vue)",
      "New Logic — React freelance: blog + marketplace on GCP",
    ],
    education: "UTN — Systems Engineering (2023)",
    skills: [
      {
        label: "Frontend & Mobile",
        items:
          "React 19, React Native, TypeScript, Expo, Zustand, React Query, Vue.js, Tailwind CSS v4, Shadcn/ui",
      },
      {
        label: "Backend, Cloud & Data",
        items:
          "Node.js, NestJS, Python, FastAPI, MySQL, PostgreSQL, GCP (Vertex AI, Cloud Run), Cloudflare Workers, REST APIs",
      },
      {
        label: "AI & Automation",
        items:
          "Google ADK, LangGraph, Workers AI, Gemini, Anthropic, n8n, OpenRouter, Cursor / Claude Code",
      },
      {
        label: "DevOps, Quality & Testing",
        items:
          "CI/CD, Docker, Git, Sentry, New Relic, Pytest, Jest, Vitest, Playwright, SonarQube",
      },
      {
        label: "Process",
        items: "SCRUM, GitFlow, code reviews, Jira, Confluence",
      },
    ],
  },
} as const;

const about = copy[lang];
---

<BaseLayout lang={lang} title={t("about.title")} description={about.bio}>
  <SiteHeader slot="header" lang={lang} />

  <section class="about">
    <h1 class="display">{t("about.title")}</h1>
    <p class="years mono">
      <span class="years-num">{yearsExp}+</span>
      {t("about.experience")}
    </p>
    <p class="bio">{about.bio}</p>

    <div class="grid">
      <section class="section">
        <p class="mono section-label">{t("about.rolesLabel")}</p>
        <ul class="bullets">
          {about.roles.map((role) => <li>{role}</li>)}
        </ul>
      </section>

      <section class="section">
        <p class="mono section-label">{t("about.educationLabel")}</p>
        <p class="line">{about.education}</p>
      </section>

      <section class="section">
        <p class="mono section-label">{t("about.linksLabel")}</p>
        <ul class="links">
          <li>
            <a
              href="https://www.linkedin.com/in/ramiro-cerdá-619983177/"
              rel="noreferrer"
              target="_blank">LinkedIn</a
            >
          </li>
          <li>
            <a href="https://github.com/ramiro-c" rel="noreferrer" target="_blank">GitHub</a>
          </li>
          <li><a href="mailto:rami992009@gmail.com">rami992009@gmail.com</a></li>
        </ul>
      </section>
    </div>

    <section class="skills">
      <p class="mono section-label">{t("about.skillsLabel")}</p>
      <ul class="skill-list">
        {
          about.skills.map((group) => (
            <li>
              <span class="skill-label">{group.label}</span>
              <span class="skill-items">{group.items}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  .about {
    padding: 1rem 0 2rem;
  }
  .display {
    margin: 0 0 0.75rem;
    font-size: clamp(2.2rem, 7vw, 3.6rem);
    line-height: 0.95;
  }
  .years {
    margin: 0 0 1.25rem;
    color: var(--muted-2);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }
  .years-num {
    color: var(--accent);
    font-weight: 700;
    margin-right: 0.35rem;
  }
  .bio {
    max-width: 44rem;
    margin: 0 0 2rem;
    color: var(--muted);
    font-size: 1.02rem;
  }
  .grid {
    display: grid;
    gap: 1.5rem;
  }
  .section,
  .skills {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .skills {
    margin-top: 1.5rem;
  }
  .section-label {
    margin: 0 0 0.75rem;
    font-size: 0.8rem;
    color: var(--muted-2);
  }
  .bullets,
  .links {
    margin: 0;
    padding-left: 1.1rem;
    display: grid;
    gap: 0.45rem;
  }
  .line {
    margin: 0;
    color: var(--text);
  }
  .links a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .skill-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .skill-list li {
    display: grid;
    gap: 0.2rem;
    padding-left: 0.85rem;
    border-left: 3px solid var(--accent);
  }
  .skill-label {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .skill-items {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }
  }
</style>
