---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import { getLocalizedPath, useTranslations } from "../../../i18n/utils";

const lang = "en";
const t = useTranslations(lang);
const notes = (await getCollection("notes"))
  .filter((note) => note.data.lang === lang && !note.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .map((note) => ({
    slug: note.data.slug || note.id.replace(/^(es|en)\//, ""),
    title: note.data.title,
    description: note.data.description,
    dateStr: note.data.pubDate.toLocaleDateString("en-US", { timeZone: "UTC", day: "2-digit", month: "short", year: "numeric" }),
  }));
---

<BaseLayout lang={lang} title={t("notes.title")} description={t("notes.description")}>
  <SiteHeader slot="header" lang={lang} />

  <section class="notes">
    <p class="mono label">02 / {t("notes.title").toUpperCase()}</p>
    <h1 class="display heading">{t("notes.title")}</h1>

    {notes.length === 0 ? (
      <p class="empty">{t("notes.empty")}</p>
    ) : (
      <ul class="list">
        {notes.map((note, i) => (
          <li>
            <a href={getLocalizedPath(lang, `/notes/${note.slug}/`)}>
              <span class="row-head">
                <span class="num mono">{String(i + 1).padStart(2, "0")}</span>
                <span class="date mono">{note.dateStr}</span>
              </span>
              <span class="title">{note.title}</span>
              <span class="summary">{note.description}</span>
              <span class="go mono">{t("notes.read")}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  .notes {
    padding: 1rem 0 2rem;
  }
  .label {
    margin: 0 0 0.75rem;
    color: var(--muted-2);
    font-size: 0.8rem;
  }
  .heading {
    margin: 0 0 1.5rem;
    font-size: clamp(2.2rem, 7vw, 3.6rem);
    line-height: 0.95;
  }
  .empty {
    color: var(--muted);
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .list li {
    border-top: 2px solid var(--border);
    padding: 1.1rem 0 1.25rem;
  }
  .list li:last-child {
    border-bottom: 2px solid var(--border);
  }
  .list li a {
    display: grid;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
  }
  .row-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .num {
    color: var(--accent);
    font-size: 0.75rem;
  }
  .date {
    font-size: 0.68rem;
    color: var(--muted-2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .title {
    font-family: "Archivo Black", sans-serif;
    font-size: clamp(1.3rem, 3.6vw, 1.9rem);
    line-height: 1.05;
    transition: color 0.15s ease;
  }
  .list li a:hover .title {
    color: var(--accent);
  }
  .summary {
    color: var(--muted);
    font-size: 0.9rem;
    max-width: 46ch;
  }
  .go {
    font-size: 0.7rem;
    color: var(--muted-2);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .list li a:hover .go {
    opacity: 1;
    transform: none;
    color: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .title,
    .go {
      transition: none;
    }
    .go {
      opacity: 1;
      transform: none;
    }
  }
</style>