---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getLocalizedPath, useTranslations } from "../../i18n/utils";

const lang = "es";
const t = useTranslations(lang);
const notes = (await getCollection("notes"))
  .filter((note) => note.data.lang === lang && !note.data.draft)
  .toSorted((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .map((note) => ({
    slug: note.data.slug || note.id.replace(/^(es|en)\//, ""),
    title: note.data.title,
    description: note.data.description,
    dateStr: note.data.pubDate.toLocaleDateString("es-AR", {
      timeZone: "UTC",
      day: "2-digit",
      month: "short",
      year: "numeric",
    }),
  }));
---

<BaseLayout lang={lang} title={t("notes.title")} description={t("notes.description")}>
  <SiteHeader slot="header" lang={lang} />

  <section class="notes">
    <p class="label caption-3">02 / {t("notes.title")}</p>
    <h1 class="heading-1">{t("notes.title")}</h1>

    {notes.length === 0 ? (
      <p class="empty body-3">{t("notes.empty")}</p>
    ) : (
      <ul class="list">
        {notes.map((note, i) => (
          <li>
            <a href={getLocalizedPath(lang, `/notes/${note.slug}/`)}>
              <span class="row-head">
                <span class="num mono caption-4">{String(i + 1).padStart(2, "0")}</span>
                <span class="date mono caption-4">{note.dateStr}</span>
              </span>
              <span class="title title-1">{note.title}</span>
              <span class="summary body-6">{note.description}</span>
              <span class="go caption-4">{t("notes.read")}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>

  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>

<style>
  /* Visual system: landing-page-design skill Part B. Layout only; type comes
     from the named text style classes in src/styles/global.css. */
  .notes {
    padding: var(--space-200) 0 var(--space-600);
  }
  .label {
    margin: 0 0 var(--space-100);
    color: var(--muted-2);
  }
  .notes h1 {
    margin: 0 0 var(--space-300);
  }
  .empty {
    color: var(--muted);
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .list li {
    border-top: 1px solid var(--border);
    padding: var(--space-200) 0 var(--space-300);
  }
  .list li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .list li a {
    display: grid;
    gap: var(--space-50);
    text-decoration: none;
    color: inherit;
    transition: transform var(--dur-color) var(--ease-out);
  }
  .list li a:active {
    transform: scale(0.98);
  }
  .row-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .num {
    color: var(--accent-text);
  }
  .date {
    color: var(--muted-2);
  }
  .title {
    transition: color var(--dur-color) var(--ease-out);
  }
  .list li a:hover .title {
    color: var(--accent-text);
  }
  .summary {
    max-width: 46ch;
    color: var(--muted);
  }
  .go {
    color: var(--muted-2);
    opacity: 0;
    transform: translateX(calc(var(--space-75) * -1));
    transition:
      opacity var(--dur-color) var(--ease-out),
      transform var(--dur-move) var(--ease-out);
  }
  .list li a:hover .go,
  .list li a:focus-within .go {
    opacity: 1;
    transform: none;
    color: var(--accent-text);
  }
  @media (max-width: 720px) {
    .notes h1 {
      font-size: var(--text-4xl);
      line-height: 40px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .title,
    .go {
      transition: none;
    }
    .go {
      opacity: 1;
      transform: none;
    }
    .list li a:active {
      transform: none;
    }
  }
</style>
