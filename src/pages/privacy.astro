---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PrivacyNotice from "../components/PrivacyNotice.astro";

const lang = "es";
---

<BaseLayout lang={lang} title="Privacidad · Ramiro Cerdá" description="Qué guarda y qué recibe ramirocerda.com.ar. No usa cookies de terceros ni trackers.">
  <SiteHeader slot="header" lang={lang} />
  <PrivacyNotice lang={lang} />
  <SiteFooter slot="footer" lang={lang} />
</BaseLayout>
