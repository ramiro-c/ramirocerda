---
import type { Lang } from "../i18n/ui";
import { getLocalizedPath, useTranslations } from "../i18n/utils";
import { landing } from "../i18n/landing";
import { CONTACT_EMAIL } from "../config/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer site-shell caption-2">
  <p>
    {t("footer.line")} · <span>{year}</span>
  </p>
  <p class="footer-links caption-2">
    <a href="https://github.com/ramiro-c" rel="noreferrer" target="_blank">
      GitHub
    </a>
    <span aria-hidden="true">·</span>
    <a href="https://www.linkedin.com/in/cerdaramiro/" rel="noreferrer" target="_blank">
      LinkedIn
    </a>
    <span aria-hidden="true">·</span>
    <a href={`mailto:${CONTACT_EMAIL}`}>{t("footer.email")}</a>
    <button
      class="copy-email"
      type="button"
      data-copy-email={CONTACT_EMAIL}
      data-label={t("footer.copyEmail")}
      data-done={t("footer.copied")}
    >
      {t("footer.copyEmail")}
    </button>
    <span class="sr-only" aria-live="polite" data-copy-status></span>
    <span aria-hidden="true">·</span>
    <a href={getLocalizedPath(lang, "/privacy/")}>{landing[lang].notice.link}</a>
  </p>
</footer>

<script>
  // Copy the address instead of opening a mail client: many visitors use webmail
  // and a mailto link does nothing for them.
  const button = document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  if (button && navigator.clipboard) {
    let timer: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyEmail ?? "");
      } catch {
        return;
      }
      button.textContent = button.dataset.done ?? "";
      if (status) status.textContent = button.dataset.done ?? "";
      clearTimeout(timer);
      timer = setTimeout(() => {
        button.textContent = button.dataset.label ?? "";
        if (status) status.textContent = "";
      }, 2000);
    });
  } else if (button) {
    button.hidden = true;
  }
</script>

<style>
  .footer {
    margin-top: var(--space-800);
    padding: var(--space-300) 0 var(--space-600);
    border-top: 1px solid var(--border);
    color: var(--muted-2);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-75);
    margin: var(--space-50) 0 0;
  }

  .footer-links a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    transition:
      color var(--dur-color) var(--ease-out),
      transform var(--dur-color) var(--ease-out);
  }

  .copy-email {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline dotted;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    cursor: pointer;
    transition: color var(--dur-color) var(--ease-out);
  }
  .copy-email:hover {
    color: var(--text);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .footer-links a:hover {
    color: var(--text);
  }
  .footer-links a:active {
    transform: scale(0.98);
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-links a:active {
      transform: none;
    }
  }
</style>
